y sent patient history prior work patient id records\", \"maxResults\": 5, \"minScore\": 0.2}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":115,"output":129,"cacheRead":8960,"cacheWrite":0,"totalTokens":9204,"cost":{"input":0.00028750000000000005,"output":0.001935,"cacheRead":0.00224,"cacheWrite":0,"total":0.0044624999999999995}},"stopReason":"toolUse","timestamp":1775899152273}}
