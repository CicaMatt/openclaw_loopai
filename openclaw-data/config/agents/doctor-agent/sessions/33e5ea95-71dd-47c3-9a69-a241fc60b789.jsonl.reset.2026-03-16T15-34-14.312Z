ce time\": \"2.2238 s\",\n                        \"classes\": \"kidney_tumor\",\n                        \"confidence\": 0.9999781847000122\n                      },\n                      \"metrics\": {},\n                      \"artifacts\": {\n                        \"input_file\": true,\n                        \"output_file\": false,\n                        \"input_dataframe\": false,\n                        \"model_file\": false\n                      }\n                    },\n                    \"node_name_dict\": \"kidney_cancer_detection_model\",\n                    \"executed\": \"completed\",\n                    \"node_id\": \"6986172e677ea52be211de08\",\n                    \"prototype_id\": \"69b7ce309fc31ca2c4714132\"\n                  }\n                ],\n                \"tracking\": {\n                  \"run_id\": \"string\",\n                  \"start\": false,\n                  \"experiment_name\": \"string\",\n                  \"workflow_name\": \"string\",\n                  \"workflow_type\": \"experiment\",\n                  \"workflow_id\": \"string\",\n                  \"workflow_run_id\": \"string\",\n                  \"tags\": {\n                    \"additionalProp1\": \"string\",\n                    \"additionalProp2\": \"string\",\n                    \"additionalProp3\": \"string\"\n                  },\n                  \"parameters\": {\n                    \"File Path\": \"upload/2026-03-16_12.09.13_2d4sAjaieji6aqJHWzlq/file_0---33404996-0f8a-42d2-ab81-d68addcff5e5.jpg\",\n                    \"Sheet Name\": 0,\n                    \"Document Type\": \"jpg\",\n                    \"Document Size\": \"0.022 Mb\"\n                  },\n                  \"metrics\": {},\n                  \"artifacts\": {\n                    \"input_file\": true,\n                    \"output_file\": false,\n                    \"input_dataframe\": false,\n                    \"model_file\": false\n                  },\n           