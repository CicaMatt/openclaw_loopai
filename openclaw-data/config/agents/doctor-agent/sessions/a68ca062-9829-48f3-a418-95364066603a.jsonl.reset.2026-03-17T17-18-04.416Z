\": \"#407C9E\",\n                  \"notexecuted_background_color\": \"#FFFFFF\",\n                  \"executed_background_color\": \"#407C9E\",\n                  \"executed_border_color\": \"#0F4873\"\n                },\n                \"data\": {\n                  \"general_parameters\": {\n                    \"filename\": \"upload/2026-03-17_16.54.03_IZvyfewibsHMaqGCAiU5/kidney_test2---55fe09ea-9865-48be-a13c-b75cf1196d84.jpg\",\n                    \"storage_ref\": \"nodes_bucket\"\n                  },\n                  \"specific_parameters\": {\n                    \"type\": \"jpg\",\n                    \"sep\": \",\",\n                    \"sheet_name\": 0,\n                    \"encoding\": \"latin-1\",\n                    \"columns\": {}\n                  }\n                },\n                \"children\": [\n                  {\n                    \"node_category\": \"build_ai_tool\",\n                    \"node_sub_category\": \"Third Party Algorithm\",\n                    \"node_name\": \"kidney_cancer_detection_model\",\n                    \"node_label\": \"Kidney Cancer Detection\",\n                    \"node_description\": \"Kidney Cancer Detection\",\n                    \"endpoints\": [\n                      {\n                        \"position\": 0,\n                        \"endpoint\": \"/nodes/ai_tool/kidney-cancer-detection-model\"\n                      }\n                    ],\n                    \"allowed_node_types\": [\n                      \"operator\",\n                      \"ai_tool\",\n                      \"evaluation_visualization\",\n                      \"process_automation\",\n                      \"output\"\n                    ],\n                    \"style\": {\n                      \"icon\": \"<svg width=\\\"22\\\" height=\\\"22\\\" viewBox=\\\"0 0 22 22\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n <path d=\\\"M12.0377 11.6211H11.2075V19.0928H12.0377V11.6211Z\\\" fill=\\\"#5B022