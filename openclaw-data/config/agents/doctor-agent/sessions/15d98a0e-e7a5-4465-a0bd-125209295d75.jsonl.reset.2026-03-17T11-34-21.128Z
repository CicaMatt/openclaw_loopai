e Images files\",\n                            \"endpoints\": [\n                                {\"position\": 0, \"endpoint\": \"/nodes/input/upload\"},\n                                {\"position\": 0, \"endpoint\": \"/nodes/input/data-reader\"}\n                            ],\n                            \"allowed_node_types\": [\n                                \"operator\",\n                                \"ai_tool\",\n                                \"evaluation_visualization\",\n                                \"process_automation\",\n                                \"output\"\n                            ],\n                            \"style\": {\n                                \"icon\": \"<svg width=\\\"19\\\" height=\\\"23\\\" viewBox=\\\"0 0 19 23\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n <path d=\\\"M0.00173349 14.9961V17.8964V18.2963V18.3964C-0.00216686 18.3964 0.00173349 18.3964 0.00173349 18.4964C0.00173349 20.8966 4.0315 22.9968 9.00254 22.9968C13.974 22.9968 18.0033 20.8966 18.0033 18.4964V18.2963V17.9964V14.9961H0.00173349Z\\\" fill=\\\"#2B5F7C\\\"/>\\n <path d=\\\"M18.0036 15.0004C18.0036 17.2097 13.9742 19.0007 9.00276 19.0007C4.03171 19.0007 0.00195312 17.2097 0.00195312 15.0004C0.00195312 12.7911 4.03171 11 9.00276 11C13.9742 11 18.0036 12.7911 18.0036 15.0004Z\\\" fill=\\\"#BDC3C7\\\"/>\\n <path d=\\\"M0.00173349 9.99609V12.8964V13.2963V13.3964C-0.00216686 13.3964 0.00173349 13.3964 0.00173349 13.4964C0.00173349 15.8966 4.0315 17.9968 9.00254 17.9968C13.974 17.9968 18.0033 15.8966 18.0033 13.4964V13.2963V12.9964V9.99609H0.00173349Z\\\" fill=\\\"#2B5F7C\\\"/>\\n <path d=\\\"M18.0036 9.99645C18.0036 12.2058 13.9742 13.9968 9.00276 13.9968C4.03171 13.9968 0.00195312 12.2058 0.00195312 9.99645C0.00195312 7.78715 4.03171 5.99609 9.00276 5.99609C13.9742 5.99609 18.0036 7.78715 18.0036 9.99645Z\\\" fill=\\\"#BDC3C7\\\"/>\\n <path d=\\\"M0.0644587 13.4961C0.0184546 13.5961 0.00195312 13.7961 0.00195312 13.9961C0.00195312