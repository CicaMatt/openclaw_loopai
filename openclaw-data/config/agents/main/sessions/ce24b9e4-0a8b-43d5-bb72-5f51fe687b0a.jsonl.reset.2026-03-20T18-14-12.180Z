{"type":"message","id":"aee9078f","parentId":"eeaf9570","timestamp":"2026-03-20T18:02:33.611Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_o00t6lvAimdgVwAUQ4HqqyNQ|fc_0e0656b03cf29aaf0169bd8ba0bb4881918659c26ae0a3d358","name":"edit","arguments":{"file_path":"/home/node/.openclaw/skills/kidney-pipeline-execution/scripts/pipeline_execution_tool.py","old_string":"def _guess_mime_type(file_path: Path) -> str:\n    guessed, _ = mimetypes.guess_type(str(file_path))\n    return guessed or \"application/octet-stream\"\n\n\ndef _encode_multipart_request(file_path: Path, mime_type: str):\n    boundary = f\"----OpenClawBoundary{uuid.uuid4().hex}\"\n    file_bytes = file_path.read_bytes()\n    body = b\"\".join(\n        [\n            f\"--{boundary}\\r\\n\".encode(\"utf-8\"),\n            (\n                f'Content-Disposition: form-data; name=\"file\"; filename=\"{file_path.name}\"\\r\\n'\n            ).encode(\"utf-8\"),\n            f\"Content-Type: {mime_type}\\r\\n\\r\\n\".encode(\"utf-8\"),\n            file_bytes,\n            b\"\\r\\n\",\n            f\"--{boundary}--\\r\\n\".encode(\"utf-8\"),\n        ]\n    )\n    content_type = f\"multipart/form-data; boundary={boundary}\"\n    return content_type, body\n\n\ndef upload_image(file_path: Path, telegram_user_id: str, timeout: int = 60) -> str:\n    params = {\n        \"storage_ref\": FIXED_STORAGE_REF,\n        \"local_file_path\": FIXED_LOCAL_FILE_PATH,\n        \"user_id\": str(telegram_user_id),\n    }\n    mime_type = _guess_mime_type(file_path)\n    content_type, body = _encode_multipart_request(file_path, mime_type)\n    upload_url = f\"{UPLOAD_BASE_URL}?{parse.urlencode(params)}\"\n    req = request.Request(\n        upload_url,\n        data=body,\n        headers={\n            \"accept\": \"application/json\",\n            \"Content-Type\": content_type,\n            \"Content-Length\": str(len(body)),\n        },\n        method=\"POST\",\n    )\n\n    try:\n        with request.urlopen(req, timeout=timeout) as resp:\n            response_text = resp.read().decode(\"utf-8\", errors=\"replace\")\n            status = resp.status\n    except error.HTTPError as exc:\n        detail = exc.read().decode(\"utf-8\", errors=\"replace\")\n        raise RuntimeError(f\"Upload failed with HTTP {exc.code}: {detail[:500]}\") from exc\n    except Exception as exc:\n        raise RuntimeError(f\"Upload request failed: {exc}\") from exc\n\n    if status < 200 or status >= 300:\n        raise RuntimeError(f\"Upload failed with HTTP {status}: {response_text[:500]}\")\n\n    try:\n        parsed = json.loads(response_text)\n    except json.JSONDecodeError as exc:\n        raise RuntimeError(\n            f\"Upload endpoint returned a non-JSON response: {response_text[:500]}\"\n        ) from exc\n\n    return _extract_uploaded_image_path(parsed)\n","new_string":"def _guess_mime_type(file_path: Path) -> str:\n    guessed, _ = mimetypes.guess_type(str(file_path))\n    return guessed or \"application/octet-stream\"\n\n\ndef _ensure_artifacts_dir() -> Path:\n    ARTIFACTS_DIR.mkdir(parents=True, exist_ok=True)\n    return ARTIFACTS_DIR\n\n\ndef upload_image(file_path: Path, telegram_user_id: str, timeout: int = 60):\n    params = {\n        \"storage_ref\": FIXED_STORAGE_REF,\n        \"local_file_path\": FIXED_LOCAL_FILE_PATH,\n        \"user_id\": str(telegram_user_id),\n    }\n    headers = {\"accept\": \"application/json\"}\n    mime_type = _guess_mime_type(file_path)\n\n    request_record = {\n        \"method\": \"POST\",\n        \"url\": UPLOAD_BASE_URL,\n        \"params\": params,\n        \"headers\": headers,\n        \"multipart_field\": {\n            \"name\": \"file\",\n            \"filename\": file_path.name,\n            \"content_type\": mime_type,\n            \"local_path\": str(file_path),\n            \"size_bytes\": file_path.stat().st_size,\n        },\n    }\n\n    artifacts_dir = _ensure_artifacts_dir()\n    upload_request_path = a