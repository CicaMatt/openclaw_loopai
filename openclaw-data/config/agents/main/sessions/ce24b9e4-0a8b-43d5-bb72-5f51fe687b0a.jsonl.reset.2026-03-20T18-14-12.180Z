           response_headers = dict(exc.headers.items()) if exc.headers else {}\n            attempt_record = {\n                \"request\": request_record,\n                \"response\": {\n                    \"status_code\": exc.code,\n                    \"headers\": response_headers,\n                    \"body_text\": response_text,\n                },\n                \"success\": False,\n                \"error\": f\"Upload failed with HTTP {exc.code}: {response_text[:500]}\",\n            }\n            attempts.append(attempt_record)\n            attempts_path.write_text(json.dumps(attempts, indent=2, ensure_ascii=False), encoding=\"utf-8\")\n            last_error = attempt_record[\"error\"]\n            continue\n        except Exception as exc:\n            attempt_record = {\n                \"request\": request_record,\n                \"response\": None,\n                \"success\": False,\n                \"error\": f\"Upload request failed: {exc}\",\n            }\n            attempts.append(attempt_record)\n            attempts_path.write_text(json.dumps(attempts, indent=2, ensure_ascii=False), encoding=\"utf-8\")\n            last_error = attempt_record[\"error\"]\n            continue\n\n        try:\n            parsed = json.loads(response_text)\n        except json.JSONDecodeError:\n            parsed = None\n\n        attempt_record = {\n            \"request\": request_record,\n            \"response\": {\n                \"status_code\": status,\n                \"headers\": response_headers,\n                \"body\": parsed if parsed is not None else None,\n                \"body_text\": response_text if parsed is None else None,\n            },\n            \"success\": False,\n            \"error\": None,\n        }\n\n        if status < 200 or status >= 300:\n            attempt_record[\"error\"] = f\"Upload failed with HTTP {status}: {response_text[:500]}\"\n            attempts.append(attempt_record)\n            attempts_path.wr