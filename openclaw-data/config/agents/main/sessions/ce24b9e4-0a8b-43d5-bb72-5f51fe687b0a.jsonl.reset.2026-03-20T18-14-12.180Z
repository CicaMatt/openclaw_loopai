{"type":"message","id":"f21881b1","parentId":"9b904c74","timestamp":"2026-03-20T18:13:27.393Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_xKdXDipAIxz0TscsWqrw6QQN|fc_0e0656b03cf29aaf0169bd8e1711748191a907321368f5ca5e","name":"edit","arguments":{"file_path":"/home/node/.openclaw/skills/kidney-pipeline-execution/scripts/pipeline_execution_tool.py","old_string":"def upload_image(file_path: Path, telegram_user_id: str, timeout: int = 60):\n    mime_type = _guess_mime_type(file_path)\n    artifacts_dir = _ensure_artifacts_dir()\n    attempts_path = artifacts_dir / \"upload-attempts.json\"\n    upload_request_path = artifacts_dir / \"upload-request.json\"\n    upload_response_path = artifacts_dir / \"upload-response.json\"\n\n    attempts = []\n    last_error = None\n\n    attempt_counter = 0\n    for storage_ref in FALLBACK_STORAGE_REFS:\n        for retry_index in range(1, UPLOAD_RETRIES_PER_STORAGE_REF + 1):\n            attempt_counter += 1\n            params = {\n                \"storage_ref\": storage_ref,\n                \"local_file_path\": FIXED_LOCAL_FILE_PATH,\n                \"user_id\": str(telegram_user_id),\n            }\n            content_type, body = _encode_multipart_request(file_path, mime_type)\n            upload_url = f\"{UPLOAD_BASE_URL}?{parse.urlencode(params)}\"\n            headers = {\n                \"accept\": \"application/json\",\n                \"Content-Type\": content_type,\n                \"Content-Length\": str(len(body)),\n            }\n\n            request_record = {\n                \"attempt\": attempt_counter,\n                \"retry_index_for_storage_ref\": retry_index,\n                \"storage_ref\": storage_ref,\n                \"method\": \"POST\",\n                \"url\": UPLOAD_BASE_URL,\n                \"query_url\": upload_url,\n                \"params\": params,\n                \"headers\": headers,\n                \"multipart_field\": {\n                    \"name\": \"file\",\n                    \"filename\": file_path.name,\n                    \"content_type\": mime_type,\n                    \"local_path\": str(file_path),\n                    \"size_bytes\": file_path.stat().st_size,\n                },\n            }\n\n            req = request.Request(upload_url, data=body, headers=headers, method=\"POST\")\n            try:\n                with request.urlopen(req, timeout=timeout) as resp:\n                    response_text = resp.read().decode(\"utf-8\", errors=\"replace\")\n                    status = resp.status\n                    response_headers = dict(resp.headers.items())\n            except error.HTTPError as exc:\n                response_text = exc.read().decode(\"utf-8\", errors=\"replace\")\n                response_headers = dict(exc.headers.items()) if exc.headers else {}\n                attempt_record = {\n                    \"request\": request_record,\n                    \"response\": {\n                        \"status_code\": exc.code,\n                        \"headers\": response_headers,\n                        \"body_text\": response_text,\n                    },\n                    \"success\": False,\n                    \"error\": f\"Upload failed with HTTP {exc.code}: {response_text[:500]}\",\n                }\n                attempts.append(attempt_record)\n                attempts_path.write_text(json.dumps(attempts, indent=2, ensure_ascii=False), encoding=\"utf-8\")\n                last_error = attempt_record[\"error\"]\n                if retry_index < UPLOAD_RETRIES_PER_STORAGE_REF:\n                    time.sleep(UPLOAD_RETRY_SLEEP_SECONDS)\n                continue\n            except Exception as exc:\n                attempt_record = {\n                    \"request\": request_record,\n                    \"response\": None,\n                    \"success\": False,\n                    \"error\": f\"Upload request failed: {exc}\",\n                }\n                attempts.append(attempt_record)\n                attempts_path.write_text(json.dumps(attempts, indent=2, ensure_ascii=False), encoding=\"utf-8\")\n                last_error = attempt_record[\"error\"]\n                if retry_index < UPLOAD_RETRIES_PER_STORAGE_REF:\n                    time.sleep(UPLOAD_RETRY_SLEEP_SECONDS)\n                continue\n\n            try:\n                parsed = json.loads(response_text)\n            except json.JSONDecodeError:\n                parsed = None\n\n            attempt_record = {\n                \"request\": request_record,\n                \"response\": {\n                    \"status_code\": status,\n                    \"headers\": response_headers,\n                    \"body\": parsed if parsed is not None else None,\n                    \"body_text\": response_text if parsed is None else None,\n                },\n                \"success\": False,\n                \"error\": None,\n            }\n\n            if status < 200 or status >= 300:\n                attempt_record[\"error\"] = f\"Upload failed with HTTP {status}: {response_text[:500]}\"\n                attempts.append(attempt_record)\n                attempts_path.write_text(json.dumps(attempts, indent=2, ensure_ascii=False), encoding=\"utf-8\")\n                last_error = attempt_record[\"error\"]\n                if retry_index < UPLOAD_RETRIES_PER_STORAGE_REF:\n                    time.sleep(UPLOAD_RETRY_SLEEP_SECONDS)\n                continue\n\n            if parsed is None:\n                attempt_record[\"error\"] = f\"Upload endpoint returned a non-JSON response: {response_text[:500]}\"\n                attempts.append(attempt_record)\n                attempts_path.write_text(json.dumps(attempts, indent=2, ensure_ascii=False), encoding=\"utf-8\")\n                last_error = attempt_record[\"error\"]\n                if retry_index < UPLOAD_RETRIES_PER_STORAGE_REF:\n                    time.sleep(UPLOAD_RETRY_SLEEP_SECONDS)\n                con