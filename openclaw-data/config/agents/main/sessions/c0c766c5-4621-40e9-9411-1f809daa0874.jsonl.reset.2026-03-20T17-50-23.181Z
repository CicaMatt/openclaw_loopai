ion/json'}\nmime = mimetypes.guess_type(str(image_path))[0] or 'application/octet-stream'\n\nupload_request_record = {\n    'method': 'POST',\n    'url': upload_url,\n    'params': params,\n    'headers': headers,\n    'file_field': {\n        'name': 'file',\n        'filename': image_path.name,\n        'mime_type': mime,\n        'local_path': str(image_path),\n        'size_bytes': image_path.stat().st_size,\n    }\n}\n(base_dir / 'upload-request.json').write_text(json.dumps(upload_request_record, indent=2), encoding='utf-8')\n\nwith image_path.open('rb') as fh:\n    upload_resp = requests.post(upload_url, params=params, headers=headers, files={'file': (image_path.name, fh, mime)}, timeout=120)\n\nupload_response_record = {\n    'status_code': upload_resp.status_code,\n    'headers': dict(upload_resp.headers),\n    'text': upload_resp.text,\n}\ntry:\n    upload_response_record['json'] = upload_resp.json()\nexcept Exception:\n    pass\n(base_dir / 'upload-response.json').write_text(json.dumps(upload_response_record, indent=2), encoding='utf-8')\nupload_resp.raise_for_status()\n\nupload_json = upload_resp.json()\nif isinstance(upload_json, list):\n    upload_json = upload_json[0]\nuploaded_path = f\"{upload_json['path']}{upload_json['filename']}\"\n\nskill_dir = Path('/home/node/.openclaw/.openclaw/skills/kidney-pipeline-execution')\n# fallback if skill dir is under home tilde literal expansion location\nif not skill_dir.exists():\n    skill_dir = Path(os.path.expanduser('~/.openclaw/skills/kidney-pipeline-execution'))\n\ntemplate_path = skill_dir / 'references' / 'request-template.json'\npayload = json.loads(template_path.read_text(encoding='utf-8'))\nPATH_FIELD_KEYS = {'filename', 'pdf_path', 'File Path'}\n\ndef looks_like_template_image_path(value: str) -> bool:\n    val = value.strip()\n    return value == '<image_path_here>' or val.startswith('upload/') or val.startswith('/upload/')\n\ndef replace_uploaded_image_path(obj, parent_key=None):\n    if isinstance(obj, dict):\n        return {k: replace_uploaded_image_path(v, k) for k, v in obj.items()}\n    if isinstance(obj, list):\n        return [replace_uploaded_image_path(v, parent_key) for v in obj]\n    if isinstance(obj, str) and (obj == '<image_path_here>' or (parent_key in PATH_FIELD_KEYS and looks_like_template_image_path(obj))):\n        return uploaded_path\n    return obj\n\npayload = replace_uploaded_image_path(copy.deepcopy(payload))\n\nplaceholder_paths = []\ndef walk(v, p='root'):\n    if isinstance(v, dict):\n        for k, child in v.items():\n            walk(child, f'{p}.{k}')\n    elif isinstance(v, list):\n        for i, child in enumerate(v):\n            walk(child, f'{p}[{i}]')\n    elif v == '<image_path_here>':\n        placeholder_paths.append(p)\nwalk(payload)\nif placeholder_paths:\n    raise RuntimeError('Unreplaced placeholders: ' + ', '.join(placeholder_paths[:10]))\n\n(base_dir / 'execution-request.json').write_text(json.dumps(payload, indent=2), encoding='utf-8')\nexec_resp = requests.post(exec_url, json=payload, headers={'accept':'application/json'}, timeout=300)\nexec_record = {\n    'status_code': exec_resp.status_code,\n    'headers': dict(exec_resp.headers),\n    'text': exec_resp.text,\n}\ntry:\n    exec_record['json'] = exec_resp.json()\nexcept Exception:\n    pass\n(base_dir / 'execution-response.json').write_text(json.dumps(exec_record, indent=2), encoding='utf-8')\nexec_resp.raise_for_status()\n\ntry:\n    result_json = exec_resp.json()\nexcept Exception:\n    result_json = exec_resp.text\n\nsummary = {\n    'saved_dir': str(base_dir),\n    'uploaded_image_path': uploaded_path,\n    'result': result_json,\n}\n(base_dir / 'result-summary.json').write_text(json.dumps(summary, indent=2), encoding='utf-8')\nprint(json.dumps(summary, indent=2))\nPY","workdir":"/home/node/.openclaw/workspace","yieldMs":1000,"timeout":600},"partialJson":"{\"command\":\"python3 - <<'PY'\\nimport json, copy, mimetypes, os\\nfrom pathlib import Path\\nimport requests\\n\\nimage_path = Path('/home/node/.openclaw/media/inbound/file_3---58728868-cf81-4dd6-8573-6a90b58f01a7.jpg').resolve()\\ntelegram_user_id = '495506013'\\nbase_dir = Path('/home/node/.openclaw/workspace/kidney_pipeline_runs/20260320T1744Z')\\nbase_dir.mkdir(parents=True, exist_ok=True)\\n\\nupload_url = 'http://looporchestra.sytes.net:4001/nodes/input/upload'\\nexec_url = 'http://looporchestra.sytes.net:4001/admin/prototype_execution/prototype_execution/'\\nparams = {\\n    'storage_ref': 'nodes_template',\\n    'local_file_path': 'upload',\\n    'user_id': telegram_user_id,\\n}\\nheaders = {'accept': 'application/json'}\\nmime = mimetypes.guess_type(str(image_path))[0] or 'application/octet-stream'\\n\\nupload_request_record = {\\n    'method': 'POST',\\n    'url': upload_url,\\n    'params': params,\\n    'headers': headers,\\n    'file_field': {\\n        'name': 'file',\\n        'filename': image_path.name,\\n        'mime_type': mime,\\n        'local_path': str(image_path),\\n        'size_bytes': image_path.stat().st_size,\\n    }\\n}\\n(base_dir / 'upload-request.json').write_text(json.dumps(upload_request_record, indent=2), encoding='utf-8')\\n\\nwith image_path.open('rb') as fh:\\n    upload_resp = requests.post(upload_url, params=params, headers=headers, files={'file': (image_path.name, fh, mime)}, timeout=120)\\n\\nupload_response_record = {\\n    'status_code': upload_resp.status_code,\\n    'headers': dict(upload_resp.headers),\\n    'text': upload_resp.text,\\n}\\ntry:\\n    upload_response_record['json'] = upload_resp.json()\\nexcept Exception:\\n    pass\\n(base_dir / 'upload-response.json').write_text(json.dumps(upload_response_record, indent=2), encoding='utf-8')\\nupload_resp.raise_for_status()\\n\\nupload_json = upload_resp.json()\\nif isinstance(upload_json, list):\\n    upload_json = upload_json[0]\\nuploaded_path = f\\\"{upload_json['path']}{upload_json['filename']}\\\"\\n\\nskill_dir = Path('/home/node/.openclaw/.openclaw/skills/kidney-pipeline-execution')\\n# fallback if skill dir is under home tilde literal expansion location\\nif not skill_dir.exists():\\n    skill_dir = Path(os.path.expanduser('~/.openclaw/skills/kidney-pipeline-execution'))\\n\\ntemplate_path = skill_dir / 'references' / 'request-template.json'\\npayload = json.loads(template_path.read_text(encoding='utf-8'))\\nPATH_FIELD_KEYS = {'filename', 'pdf_path', 'File Path'}\\n\\ndef looks_like_template_image_path(value: str) -> bool:\\n    val = value.strip()\\n    return value == '<image_path_here>' or val.startswith('upload/') or val.startswith('/upload/')\\n\\ndef replace_uploaded_image_path(obj, parent_key=None):\\n    if isinstance(obj, dict):\\n        return {k: replace_uploaded_image_path(v, k) for k, v in obj.items()}\\n    if isinstance(obj, list):\\n        return [replace_uploaded_image_path(v, parent_key) for v in obj]\\n    if isinstance(obj, str) and (obj == '<image_path_here>' or (parent_key in PATH_FIELD_KEYS and looks_like_template_image_path(obj))):\\n        return uploaded_path\\n    return obj\\n\\npayload = replace_uploaded_image_path(copy.deepcopy(payload))\\n\\nplaceholder_paths = []\\ndef walk(v, p='root'):\\n    if isinstance(v, dict):\\n        for k, child in v.items():\\n            walk(child, f'{p}.{k}')\\n    elif isinstance(v, list):\\n        for i, child in enumerate(v):\\n            walk(child, f'{p}[{i}]')\\n    elif v == '<image_path_here>':\\n        placeholder_paths.append(p)\\nwalk(payload)\\nif placeholder_paths:\\n    raise RuntimeError('Unreplaced placeholders: ' + ', '.join(placeholder_paths[:10]))\\n\\n(base_dir / 'execution-request.json').write_text(json.dumps(payload, indent=2), encoding='utf-8')\\nexec_resp = requests.post(exec_url, json=payload, headers={'accept':'application/json'}, timeout=300)\\nexec_record = {\\n    'status_code': exec_resp.status_code,\\n    'headers': dict(exec_resp.headers),\\n    'text': exec_resp.text,\\n}\\ntry:\\n    exec_record['json'] = exec_resp.json()\\nexcept Exception:\\n    pass\\n(base_dir / 'execution-response.json').write_text(json.dumps(exec_record, indent=2), encoding='utf-8')\\nexec_resp.raise_for_status()\\n\\ntry:\\n    result_json = exec_resp.json()\\nexcept Exception:\\n    result_json = exec_resp.text\\n\\nsummary = {\\n    'saved_dir': str(base_dir),\\n    'uploaded_image_path': uploaded_path,\\n    'result': result_json,\\n}\\n(base_dir / 'result-summary.json').write_text(json.dumps(summary, indent=2), encoding='utf-8')\\nprint(json.dumps(summary, indent=2))\\nPY\",\"workdir\":\"/home/node/.openclaw/workspace\",\"yieldMs\":1000,\"timeout\":600}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":13067,"output":1411,"cacheRead":10368,"cacheWrite":0,"totalTokens":24846,"cost":{"input":0.0326675,"output":0.021165,"cacheRead":0.0025919999999999997,"cacheWrite":0,"total":0.0564245}},"stopReason":"toolUse","timestamp":1774028708722}}
