_template',\n    'local_file_path': 'upload',\n    'user_id': telegram_user_id,\n}\nheaders = {'accept': 'application/json'}\nmime = mimetypes.guess_type(str(image_path))[0] or 'application/octet-stream'\n\nupload_request_record = {\n    'method': 'POST',\n    'url': upload_url,\n    'params': params,\n    'headers': headers,\n    'file_field': {\n        'name': 'file',\n        'filename': image_path.name,\n        'mime_type': mime,\n        'local_path': str(image_path),\n        'size_bytes': image_path.stat().st_size,\n    }\n}\n(base_dir / 'upload-request.json').write_text(json.dumps(upload_request_record, indent=2), encoding='utf-8')\n\nboundary = f'----OpenClawBoundary{uuid.uuid4().hex}'\nfile_bytes = image_path.read_bytes()\nbody = b''.join([\n    f'--{boundary}\\r\\n'.encode(),\n    f'Content-Disposition: form-data; name=\"file\"; filename=\"{image_path.name}\"\\r\\n'.encode(),\n    f'Content-Type: {mime}\\r\\n\\r\\n'.encode(),\n    file_bytes,\n    b'\\r\\n',\n    f'--{boundary}--\\r\\n'.encode(),\n])\nreq = request.Request(\n    upload_url + '?' + parse.urlencode(params),\n    data=body,\n    headers={\n        'accept': 'application/json',\n        'Content-Type': f'multipart/form-data; boundary={boundary}',\n        'Content-Length': str(len(body)),\n    },\n    method='POST'\n)\ntry:\n    with request.urlopen(req, timeout=180) as resp:\n        upload_text = resp.read().decode('utf-8', errors='replace')\n        upload_status = resp.status\n        upload_headers = dict(resp.headers)\nexcept error.HTTPError as exc:\n    upload_text = exc.read().decode('utf-8', errors='replace')\n    upload_status = exc.code\n    upload_headers = dict(exc.headers)\n    (base_dir / 'upload-response.json').write_text(json.dumps({'status_code': upload_status, 'headers': upload_headers, 'text': upload_text}, indent=2), encoding='utf-8')\n    raise\n\nupload_response_record = {'status_code': upload_status, 'headers': upload_headers, 'text': upload_text}\ntry:\n    upload_response_record['json'] = json.loads(upload_text)\nexcept Exception:\n    pass\n(base_dir / 'upload-response.json').write_text(json.dumps(upload_response_record, indent=2), encoding='utf-8')\nupload_json = json.loads(upload_text)\nif isinstance(upload_json, list):\n    upload_json = upload_json[0]\nuploaded_path = f\"{upload_json['path']}{upload_json['filename']}\"\n\nskill_dir = Path(os.path.expanduser('~/.openclaw/skills/kidney-pipeline-execution'))\ntemplate_path = skill_dir / 'references' / 'request-template.json'\npayload = json.loads(template_path.read_text(encoding='utf-8'))\nPATH_FIELD_KEYS = {'filename', 'pdf_path', 'File Path'}\n\ndef looks_like_template_image_path(value: str) -> bool:\n    val = value.strip()\n    return value == '<image_path_here>' or val.startswith('upload/') or val.startswith('/upload/')\n\ndef replace_uploaded_image_path(obj, parent_key=None):\n    if isinstance(obj, dict):\n        return {k: replace_uploaded_image_path(v, k) for k, v in obj.items()}\n    if isinstance(obj, list):\n        return [replace_uploaded_image_path(v, parent_key) for v in obj]\n    if isinstance(obj, str) and (obj == '<image_path_here>' or (parent_key in PATH_FIELD_KEYS and looks_like_template_image_path(obj))):\n        return uploaded_path\n    return obj\n\npayload = replace_uploaded_image_path(copy.deepcopy(payload))\nplaceholder_paths = []\ndef walk(v, p='root'):\n    if isinstance(v, dict):\n        for k, child in v.items():\n            walk(child, f'{p}.{k}')\n    elif isinstance(v, list):\n        for i, child in enumerate(v):\n            walk(child, f'{p}[{i}]')\n    elif v == '<image_path_here>':\n        placeholder_paths.append(p)\nwalk(payload)\nif placeholder_paths:\n    raise RuntimeError('Unreplaced placeholders: ' + ', '.join(placeholder_paths[:10]))\n\n(base_dir / 'execution-request.json').write_text(json.dumps(payload, indent=2), encoding='utf-8')\nexec_payload = json.dumps(payload).encode('utf-8')\nexec_req = request.Request(exec_url, data=exec_payload, headers={'Content-Type':'application/json','Accept':'application/json'}, method='POST')\ntry:\n    with request.urlopen(exec_req, timeout=300) as resp:\n        exec_text = resp.read().decode('utf-8', errors='replace')\n        exec_status = resp.status\n        exec_headers = dict(resp.headers)\nexcept error.HTTPError as exc:\n    exec_text = exc.read().decode('utf-8', errors='replace')\n    exec_status = exc.code\n    exec_headers = dict(exc.headers)\n    (base_dir / 'execution-response.json').write_text(json.dumps({'status_code': exec_status, 'headers': exec_headers, 'text': exec_text}, indent=2), encoding='utf-8')\n    raise\n\nexec_record = {'status_code': exec_status, 'headers': exec_headers, 'text': exec_text}\ntry:\n    exec_json = json.loads(exec_text)\n    exec_record['json'] = exec_json\nexcept Exception:\n    exec_json = exec_text\n(base_dir / 'execution-response.json').write_text(json.dumps(exec_record, indent=2), encoding='utf-8')\n\ndef deep_get(obj, path, default=None):\n    cur = obj\n    for key in path:\n        try:\n            cur = cur[key]\n        except Exception:\n            return default\n    return cur\n\nresponse_payload = exec_json['response'] if isinstance(exec_json, dict) and 'response' in exec_json else exec_json\nsummary = {\n    'saved_dir': str(base_dir),\n    'uploaded_image_path': uploaded_path,\n    'kidney_cancer_detector': {\n        'Inference time': deep_get(response_payload, ['workflows',0,'branches',0,'nodes',0,'children',0,'tracking','parameters','Inference time']),\n        'classes': deep_get(response_payload, ['workflows',0,'branches',0,'nodes',0,'children',0,'tracking','parameters','classes']),\n        'confidence': deep_get(response_payload, ['workflows',0,'branches',0,'nodes',0,'children',0,'tracking','parameters','confidence']),\n    },\n    'image_analyzer': {\n        'prediction': deep_get(response_payload, ['workflows',0,'branches',0,'nodes',0,'children',0,'children',0,'tracking','parame