derate\"\n        },\n        {\n          \"month\": \"2024-07\",\n          \"lambda\": 0.41544390754910204,\n          \"formatted\": \"0.415\",\n          \"stress_level\": \"Moderate\"\n        },\n        {\n          \"month\": \"2024-08\",\n          \"lambda\": 0.4310191940443208,\n          \"formatted\": \"0.431\",\n          \"stress_level\": \"Moderate\"\n        },\n        {\n          \"month\": \"2024-09\",\n          \"lambda\": 0.4913678222390826,\n          \"formatted\": \"0.491\",\n          \"stress_level\": \"Moderate\"\n        },\n        {\n          \"month\": \"2024-10\",\n          \"lambda\": 0.5571305153702548,\n          \"formatted\": \"0.557\",\n          \"stress_level\": \"Moderate\"\n        },\n        {\n          \"month\": \"2024-11\",\n          \"lambda\": 0.5960442374316846,\n          \"formatted\": \"0.596\",\n          \"stress_level\": \"Moderate\"\n        },\n        {\n          \"month\": \"2024-12\",\n          \"lambda\": 0.6101842031311078,\n          \"formatted\": \"0.610\",\n          \"stress_level\": \"Moderate\"\n        },\n        {\n          \"month\": \"2025-01\",\n          \"lambda\": 0.6212213844033699,\n          \"formatted\": \"0.621\",\n          \"stress_level\": \"Moderate\"\n        },\n        {\n          \"month\": \"2025-02\",\n          \"lambda\": 0.651539208087694,\n          \"formatted\": \"0.652\",\n          \"stress_level\": \"Moderate\"\n        },\n        {\n          \"month\": \"2025-03\",\n          \"lambda\": 0.6715235556410298,\n          \"formatted\": \"0.672\",\n          \"stress_level\": \"Moderate\"\n        },\n        {\n          \"month\": \"2025-04\",\n          \"lambda\": 0.6971416611991842,\n          \"formatted\": \"0.697\",\n          \"stress_level\": \"Moderate\"\n        },\n        {\n          \"month\": \"2025-05\",\n          \"lambda\": 0.7094721533041427,\n          \"formatted\": \"0.709\",\n          \"stress_level\": \"High\"\n        },\n  