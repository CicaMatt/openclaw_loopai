{"type":"message","id":"3df312cb","parentId":"6b1c323a","timestamp":"2026-03-29T11:16:27.720Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_2cl5dP9pPYYQQnutfvHibUHe|fc_02a73fafca88252d0169c909fe4a308191a6e55f922de3fd25","name":"write","arguments":{"file_path":"/home/node/.openclaw/skills/slm-inference/scripts/query_slm_inference.py","content":"#!/usr/bin/env python3\nimport argparse\nimport json\nimport sys\nfrom urllib import error, request\n\nENDPOINT = \"http://looporchestra.sytes.net:8007/chat\"\n\n\ndef extract_answer(body: str) -> str:\n    try:\n        parsed = json.loads(body)\n    except json.JSONDecodeError:\n        return body.strip()\n\n    if isinstance(parsed, str):\n        return parsed.strip()\n\n    if not isinstance(parsed, dict):\n        return json.dumps(parsed, indent=2)\n\n    for key in (\"answer\", \"Answer\", \"response\", \"message\"):\n        value = parsed.get(key)\n        if value is not None:\n            if isinstance(value, str):\n                text = value.strip()\n                try:\n                    nested = json.loads(text)\n                    if isinstance(nested, dict):\n                        for nested_key in (\"answer\", \"Answer\", \"response\", \"message\"):\n                            nested_value = nested.get(nested_key)\n                            if nested_value is not None:\n                                return str(nested_value).strip()\n                except json.JSONDecodeError:\n                    pass\n                return text\n            return json.dumps(value, indent=2)\n\n    data = parsed.get(\"data\")\n    if isinstance(data, dict):\n        for key in (\"answer\", \"Answer\", \"response\", \"message\"):\n            value = data.get(key)\n            if value is not None:\n                return value if isinstance(value, str) else json.dumps(value, indent=2)\n\n    return json.dumps(parsed, indent=2)\n\n\ndef call_endpoint(question: str, timeout: int = 45) -> str:\n    payload = json.dumps({\"question\": question}).encode(\"utf-8\")\n\n    req = request.Request(\n        ENDPOINT,\n        data=payload,\n        headers={\"Content-Type\": \"application/json\", \"Accept\": \"application/json\"},\n        method=\"POST\",\n    )\n\n    try:\n        with request.urlopen(req, timeout=timeout) as resp:\n            body = resp.read().decode(\"utf-8\", errors=\"replace\")\n    except error.HTTPError as e:\n        detail = e.read().decode(\"utf-8\", errors=\"replace\")\n        raise RuntimeError(f\"HTTP {e.code}: {detail}\") from e\n    except Exception as e:\n        raise RuntimeError(f\"Request failed: {e}\") from e\n\n    return extract_answer(body)\n\n\ndef main():\n    parser = argparse.ArgumentParser(\n        description=\"Query the SLM inference endpoint and print the returned answer\"\n    )\n    parser.add_argument(\"question\", help=\"Question about patient health data stored in records\")\n    parser.add_argument(\"--timeout\", type=int, default=45)\n    args = parser.parse_args()\n\n    answer = call_endpoint(args.question, timeout=args.timeout)\n    print(answer)\n\n\nif __name__ == \"__main__\":\n    try:\n        main()\n    except Exception as exc:\n        print(f\"ERROR: {exc}\", file=sys.stderr)\n        sys.exit(1)\n"},"partialJson":"{\"file_path\":\"/home/node/.openclaw/skills/slm-inference/scripts/query_slm_inference.py\",\"content\":\"#!/usr/bin/env python3\\nimport argparse\\nimport json\\nimport sys\\nfrom urllib import error, request\\n\\nENDPOINT = \\\"http://looporchestra.sytes.net:8007/chat\\\"\\n\\n\\ndef extract_answer(body: str) -> str:\\n    try:\\n        parsed = json.loads(body)\\n    except json.JSONDecodeError:\\n        return body.strip()\\n\\n    if isinstance(parsed, str):\\n        return parsed.strip()\\n\\n    if not isinstance(parsed, dict):\\n        return json.dumps(parsed, indent=2)\\n\\n    for key in (\\\"answer\\\", \\\"Answer\\\", \\\"response\\\", \\\"message\\\"):\\n        value = parsed.get(key)\\n        if value is not None:\\n            if isinstance(value, str):\\n                text = value.strip()\\n                try:\\n                    nested = json.loads(text)\\n                    if isinstance(nested, dict):\\n                        for nested_key in (\\\"answer\\\", \\\"Answer\\\", \\\"response\\\", \\\"message\\\"):\\n                            nested_value = nested.get(nested_key)\\n                            if nested_value is not None:\\n                                return str(nested_value).strip()\\n                except json.JSONDecodeError:\\n                    pass\\n                return text\\n            return json.dumps(value, indent=2)\\n\\n    data = parsed.get(\\\"data\\\")\\n    if isinstance(data, dict):\\n        for key in (\\\"answer\\\", \\\"Answer\\\", \\\"response\\\", \\\"message\\\"):\\n            value = data.get(key)\\n            if value is not None:\\n                return value if isinstance(value, str) else json.dumps(value, indent=2)\\n\\n    return json.dumps(parsed, indent=2)\\n\\n\\ndef call_endpoint(question: str, timeout: int = 45) -> str:\\n    payload = json.dumps({\\\"question\\\": question}).encode(\\\"utf-8\\\")\\n\\n    req = request.Request(\\n        ENDPOINT,\\n        data=payload,\\n        headers={\\\"Content-Type\\\": \\\"application/json\\\", \\\"Accept\\\": \\\"application/json\\\"},\\n        method=\\\"POST\\\",\\n    )\\n\\n    try:\\n        with request.urlopen(req, timeout=timeout) as resp:\\n            body = resp.read().decode(\\\"utf-8\\\", errors=\\\"replace\\\")\\n    except error.HTTPError as e:\\n        detail = e.read().decode(\\\"utf-8\\\", errors=\\\"replace\\\")\\n        raise RuntimeError(f\\\"HTTP {e.code}: {detail}\\\") from e\\n    except Exception as e:\\n        raise RuntimeError(f\\\"Request failed: {e}\\\") from e\\n\\n    return extract_answer(body)\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser(\\n        description=\\\"Query the SLM inference endpoint and print the returned answer\\\"\\n    )\\n    parser.add_argument(\\\"question\\\", help=\\\"Question about patient health data stored in records\\\")\\n    parser.add_argument(\\\"--timeout\\\", type=int, default=45)\\n    args = parser.parse_args()\\n\\n    answer = call_endpoint(args.question, timeout=args.timeout)\\n    print(answer)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    try:\\n        main()\\n    except Exception as exc:\\n        print(f\\\"ERROR: {exc}\\\", file=sys.stderr)\\n        sys.exit(1)\\n\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":235,"output":746,"cacheRead":16512,"cacheWrite":0,"totalTokens":17493,"cost":{"input":0.0005875,"output":0.01119,"cacheRead":0.004128,"cacheWrite":0,"total":0.0159055}},"stopReason":"toolUse","timestamp":1774782973130}}
