ers': {\n        'Content-Type': f'multipart/form-data; boundary={boundary}',\n        'Content-Length': str(len(upload_body)),\n        'Accept': 'application/json'\n    },\n    'file_name': image_path.name,\n    'file_path': str(image_path),\n    'body_sha256': hashlib.sha256(upload_body).hexdigest(),\n    'body_base64': base64.b64encode(upload_body).decode('ascii')\n}\n(outdir / 'upload_request.json').write_text(json.dumps(upload_request, indent=2), encoding='utf-8')\n\nupload_result = mod.upload_image(str(image_path), telegram_user_id)\n(outdir / 'upload_response.json').write_text(json.dumps(upload_result, indent=2), encoding='utf-8')\n\npayload_obj = mod.build_payload(upload_result['uploaded_image_path'])\nendpoint_request = {\n    'method': 'POST',\n    'url': mod.EXECUTION_ENDPOINT,\n    'headers': {\n        'Content-Type': 'application/json',\n        'Accept': 'application/json'\n    },\n    'json_body': payload_obj\n}\n(outdir / 'endpoint_request.json').write_text(json.dumps(endpoint_request, indent=2), encoding='utf-8')\n\nresult = mod.call_pipeline_execution(upload_result['uploaded_image_path'])\nresult['local_image_path_used'] = str(image_path)\nresult['telegram_user_id_used_for_upload'] = telegram_user_id\nresult['upload_path'] = upload_result['upload_path']\nresult['upload_filename'] = upload_result['upload_filename']\nresult['upload_request_url'] = upload_result['upload_request_url']\nresult['raw_upload_response'] = upload_result['raw_upload_response']\n(outdir / 'endpoint_response.json').write_text(json.dumps(result, indent=2), encoding='utf-8')\n\nsummary = {\n    'artifacts_dir': str(outdir),\n    'upload_request_file': str(outdir / 'upload_request.json'),\n    'upload_response_file': str(outdir / 'upload_response.json'),\n    'endpoint_request_file': str(outdir / 'endpoint_request.json'),\n    'endpoint_response_file': str(outdir / 'endpoint_response.json'),\n    'meaningful_response': result.get('meaningful_response'),\n    'analyzer_image_url'