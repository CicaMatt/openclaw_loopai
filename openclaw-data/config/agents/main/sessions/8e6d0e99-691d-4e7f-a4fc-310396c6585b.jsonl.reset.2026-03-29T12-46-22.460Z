,\n {\n \"timestamp\": 1771194825,\n \"bpm\": 56.54\n },\n {\n \"timestamp\": 1771194830,\n \"bpm\": 57.38\n },\n {\n \"timestamp\": 1771194835,\n \"bpm\": 58.51\n },\n {\n \"timestamp\": 1771194840,\n \"bpm\": 56.16\n },\n {\n \"timestamp\": 1771194845,\n \"bpm\": 56.67\n },\n {\n \"timestamp\": 1771194850,\n \"bpm\": 56.92\n },\n {\n \"timestamp\": 1771194855,\n \"bpm\": 56.2\n },\n {\n \"timestamp\": 1771194860,\n \"bpm\": 52.51\n },\n {\n \"timestamp\": 1771194865,\n \"bpm\": 53.63\n },\n {\n \"timestamp\": 1771194870,\n \"bpm\": 57.29\n },\n {\n \"timestamp\": 1771194875,\n \"bpm\": 54.13\n },\n {\n \"timestamp\": 1771194880,\n \"bpm\": 56.44\n },\n {\n \"timestamp\": 1771194885,\n \"bpm\": 56.74\n },\n {\n \"timestamp\": 1771194890,\n \"bpm\": 54.94\n },\n {\n \"timestamp\": 1771194895,\n \"bpm\": 55.7\n },\n {\n \"timestamp\": 1771194900,\n \"bpm\": 54.5\n },\n {\n \"timestamp\": 1771194905,\n \"bpm\": 55.54\n },\n {\n \"timestamp\": 1771194910,\n \"bpm\": 54.32\n },\n {\n \"timestamp\": 1771194915,\n \"bpm\": 54.51\n },\n {\n \"timestamp\": 1771194920,\n \"bpm\": 55.51\n },\n {\n \"timestamp\": 1771194925,\n \"bpm\": 54.91\n },\n {\n \"timestamp\": 1771194930,\n \"bpm\": 54.19\n },\n {\n \"timestamp\": 1771194935,\n \"bpm\": 51.93\n },\n {\n \"timestamp\": 1771194940,\n \"bpm\": 55.32\n },\n {\n \"timestamp\": 1771194945,\n \"bpm\": 53.99\n },\n {\n \"timestamp\": 1771194950,\n \"bpm\": 53.5\n },\n {\n \"timestamp\": 1771194955,\n \"bpm\": 54.61\n },\n {\n \"timestamp\": 1771194960,\n \"bpm\": 54.05\n },\n {\n \"timestamp\": 1771194965,\n \"bpm\": 53.03\n },\n {\n \"timestamp\": 1771194970,\n \"bpm\": 56.83\n },\n {\n \"timestamp\": 1771194975,\n \"bpm\": 52.35\n },\n {\n \"timestamp\": 1771194980,\n \"bpm\": 56.6\n },\n {\n \"timestamp\": 1771194985,\n \"bpm\": 55.86\n },\n {\n \"timestamp\": 1771194990,\n \"bpm\": 54.72\n },\n {\n \"timestamp\": 1771194995,\n \"bpm\": 53.42\n },\n {\n \"timestamp\": 1771195000,\n \"bpm\": 56.91\n },\n {\n \"timestamp\": 17