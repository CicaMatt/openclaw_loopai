ode_label\\\": \\\"Image Analyzer\\\",\\n                        \\\"node_description\\\": \\\"Image Analyzer\\\",\\n                        \\\"endpoints\\\": [\\n                          {\\n                            \\\"position\\\": 0,\\n                            \\\"endpoint\\\": \\\"/nodes/ai_tool/image-analyzer\\\"\\n                          }\\n                        ],\\n                        \\\"allowed_node_types\\\": [\\n                          \\\"operator\\\",\\n                          \\\"ai_tool\\\",\\n                          \\\"evaluation_visualization\\\",\\n                          \\\"process_automation\\\",\\n                          \\\"output\\\"\\n                        ],\\n                        \\\"style\\\": {\\n                          \\\"icon\\\": \\\"<svg width=\\\\\\\"22\\\\\\\" height=\\\\\\\"22\\\\\\\" viewBox=\\\\\\\"0 0 22 22\\\\\\\" fill=\\\\\\\"none\\\\\\\" xmlns=\\\\\\\"http://www.w3.org/2000/svg\\\\\\\">\\\\n        <path d=\\\\\\\"M12.0377 11.6211H11.2075V19.0928H12.0377V11.6211Z\\\\\\\" fill=\\\\\\\"#5B0228\\\\\\\"/>\\\\n        <path d=\\\\\\\"M19.3878 2.78234L18.8008 2.19531L12.5745 8.42161L13.1615 9.00863L19.3878 2.78234Z\\\\\\\" fill=\\\\\\\"#5B0228\\\\\\\"/>\\\\n        <path d=\\\\\\\"M11.086 11.087L10.499 10.5L2.1973 18.8017L2.78432 19.3887L11.086 11.087Z\\\\\\\" fill=\\\\\\\"#5B0228\\\\\\\"/>\\\\n        <path d=\\\\\\\"M10.2558 8.0073L5.68994 3.44141L5.10292 4.02843L9.6688 8.59433L10.2558 8.0073Z\\\\\\\" fill=\\\\\\\"#5B0228\\\\\\\"/>\\\\n        <path d=\\\\\\\"M18.9724 16.7263L12.7461 10.5L12.1591 11.087L18.3854 17.3133L18.9724 16.7263Z\\\\\\\" fill=\\\\\\\"#5B0228\\\\\\\"/>\\\\n        <path d=\\\\\\\"M19.9246 4.15094C21.0708 4.15094 22.0001 3.22172 22.0001 2.07547C22.0001 0.92922 21.0708 0 19.9246 0C18.7783 0 17.8491 0.92922 17.8491 2.07547C17.8491 3.22172 18.7783 4.15094 19.9246 4.15094Z\\\\\\\" fill=\\\\\\\"#D7B4C2\\\\\\\"/>\\\\n        <path d=\\\\\\\"M11.6228 21.9986C12.7691 21.9986 13.