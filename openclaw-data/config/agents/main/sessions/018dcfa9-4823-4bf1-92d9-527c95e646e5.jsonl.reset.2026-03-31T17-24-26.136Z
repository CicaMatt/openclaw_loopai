_path}\")\n 188 \n-189     params = {\n-190         \"storage_ref\": FIXED_STORAGE_REF,\n-191         \"local_file_path\": FIXED_LOCAL_FILE_PATH,\n-192         \"user_id\": telegram_user_id,\n-193     }\n+208     query = parse.urlencode(\n+209         {\n+210             \"storage_ref\": FIXED_STORAGE_REF,\n+211             \"local_file_path\": FIXED_LOCAL_FILE_PATH,\n+212             \"user_id\": telegram_user_id,\n+213         }\n+214     )\n+215     upload_url = f\"{UPLOAD_BASE_URL}?{query}\"\n+216     boundary, body = _multipart_encode(\"file\", file_path)\n+217     req = request.Request(\n+218         upload_url,\n+219         data=body,\n+220         headers={\n+221             \"Content-Type\": f\"multipart/form-data; boundary={boundary}\",\n+222             \"Accept\": \"application/json\",\n+223         },\n+224         method=\"POST\",\n+225     )\n 194 \n 195     try:\n-196         with file_path.open(\"rb\") as handle:\n-197             files = [(\"file\", handle)]\n-198             response = requests.post(\n-199                 UPLOAD_BASE_URL,\n-200                 params=params,\n-201                 files=files,\n-202                 timeout=timeout,\n-203             )\n-204     except requests.RequestException as e:\n+228         with request.urlopen(req, timeout=timeout) as resp:\n+229             response_body = resp.read().decode(\"utf-8\", errors=\"replace\")\n+230     except error.HTTPError as e:\n+231         detail = e.read().decode(\"utf-8\", errors=\"replace\")\n+232         raise RuntimeError(f\"Upload failed with HTTP {e.code}: {detail}\") from e\n+233     except Exception as e:\n 205         raise RuntimeError(f\"Upload request failed: {e}\") from e\n 206 \n-207     if not response.ok:\n-208         raise RuntimeError(\n-209             f\"Upload failed with HTTP {response.status_code}: {response.text}\"\n-210         )\n-211 \n 212     try:\n-213         parsed = response.json()\n+237         parsed = json.loads(response_body)\n 214     except json.JSONDecodeError as e:\n 215         raise RuntimeError(\"Upload endpoint returned a non-JSON response.\") from e\n 216 \n 217     parsed = _normalize_upload_response(parsed)\n 218     remote_dir = parsed.get(\"path\")\n 219     filename = parsed.get(\"filename\")\n 220     if not isinstance(remote_dir, str) or not remote_dir:\n 221         raise RuntimeError(\"Upload response is missing 'path'.\")\n 222     if not isinstance(filename, str) or not filename:\n 223         raise RuntimeError(\"Upload response is missing 'filename'.\")\n 224 \n 225     return {\n 226         \"uploaded_image_path\": f\"{remote_dir}{filename}\",\n 227         \"upload_path\": remote_dir,\n 228         \"upload_filename\": filename,\n 229         \"telegram_user_id_used\": str(telegram_user_id),\n-230         \"upload_request_url\": response.url,\n+254         \"upload_request_url\": upload_url,\n 231         \"raw_upload_response\": parsed,\n 232     }\n 233 \n 234 \n     ...","firstChangedLine":174},"isError":false,"timestamp":1774977763454}}
