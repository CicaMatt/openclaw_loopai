t\n  --telegram-user-id TELEGRAM_USER_ID\n                        Telegram user id used as the upload endpoint's user_id\n                        query parameter.\n  --timeout TIMEOUT     Inference timeout in seconds.\n  --upload-timeout UPLOAD_TIMEOUT\n                        Upload timeout in seconds.","cwd":"/home/node/.openclaw/workspace"},"isError":false,"timestamp":1773655457236}}
