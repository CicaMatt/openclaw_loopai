ameters\": {\n                  \"filename\": \"<audio-path-here>\",\n                  \"storage_ref\": \"nodes_bucket\"\n                },\n                \"specific_parameters\": {\n                  \"type\": \"mp3\",\n                  \"sep\": \",\",\n                  \"sheet_name\": 0,\n                  \"encoding\": \"latin-1\",\n                  \"columns\": {}\n                }\n              },\n              \"children\": [\n                {\n                  \"node_category\": \"build_ai_tool\",\n                  \"node_sub_category\": \"Loop Ready Model\",\n                  \"node_name\": \"voice_depression_detection_model\",\n                  \"node_label\": \"Voice Depression Detection\",\n                  \"node_description\": \"Voice Depression\",\n                  \"endpoints\": [\n                    {\n                      \"position\": 0,\n                      \"endpoint\": \"/nodes/ai_tool/Voice-Depression-Detection-model\"\n                    }\n                  ],\n                  \"allowed_node_types\": [\n                    \"operator\",\n                    \"ai_tool\",\n                    \"evaluation_visualization\",\n                    \"process_automation\",\n                    \"output\"\n                  ],\n                  \"style\": {\n                    \"icon\": \"<svg width=\\\"22\\\" height=\\\"22\\\" viewBox=\\\"0 0 22 22\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n        <path d=\\\"M12.0377 11.6211H11.2075V19.0928H12.0377V11.6211Z\\\" fill=\\\"#5B0228\\\"/>\\n        <path d=\\\"M19.3878 2.78234L18.8008 2.19531L12.5745 8.42161L13.1615 9.00863L19.3878 2.78234Z\\\" fill=\\\"#5B0228\\\"/>\\n        <path d=\\\"M11.086 11.087L10.499 10.5L2.1973 18.8017L2.78432 19.3887L11.086 11.087Z\\\" fill=\\\"#5B0228\\\"/>\\n        <path d=\\\"M10.2558 8.0073L5.68994 3.44141L5.10292 4.02843L9.6688 8.59433L10.2558 8.0073Z\\\" fill=\\\"#5B0228\\\"/>\\n        <path d=\\\"M18.9724 16.7263L12.74