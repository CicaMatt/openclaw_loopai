 confidence,\n            \"result_image_url\": _coerce_file_url(mapping.get(\"file_path\")),\n        }\n\n    return None\n\n\ndef extract_prediction(value):\n    if not isinstance(value, dict):\n        raise RuntimeError(\"Endpoint returned a non-object JSON response.\")\n\n    flat_prediction = _prediction_from_mapping(value)\n    if flat_prediction:\n        return flat_prediction\n\n    perception = value.get(\"data\", {}).get(\"tracking_data\", {}).get(\"perception\", [])\n    if isinstance(perception, list) and perception:\n        first = perception[0]\n        nested_prediction = _prediction_from_mapping(first)\n        if nested_prediction:\n            return nested_prediction\n\n    raise RuntimeError(\n        \"Endpoint JSON is missing prediction data in both flat and nested formats\"\n    )\n","new_string":"def _coerce_file_url(candidate):\n    if not isinstance(candidate, str):\n        return None\n\n    normalized = candidate.strip()\n    if normalized.startswith(\"[URL]\"):\n        normalized = normalized[len(\"[URL]\") :].strip()\n\n    parsed = parse.urlparse(normalized)\n    if parsed.scheme in {\"http\", \"https\"} and parsed.netloc:\n        return normalized\n    return None\n\n\ndef _prediction_from_mapping(mapping):\n    if not isinstance(mapping, dict):\n        return None\n\n    prediction_label = mapping.get(\"prediction_label\") or mapping.get(\"prediction\")\n    confidence = mapping.get(\"confidence\")\n    if _is_valid_prediction(prediction_label, confidence):\n        return {\n            \"prediction_label\": prediction_label,\n            \"confidence\": confidence,\n            \"result_image_url\": _coerce_file_url(mapping.get(\"file_path\")),\n        }\n\n    return None\n\n\ndef _find_first_result_image_url(obj):\n    if isinstance(obj, dict):\n        direct_url = _coerce_file_url(obj.get(\"file_path\"))\n        if direct_url:\n            return direct_url\n        for value in obj.values():\n            nested_url =