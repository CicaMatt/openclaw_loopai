\\\",\\n        \\\"message\\\",\\n        \\\"send\\\",\\n        \\\"--channel\\\",\\n        \\\"telegram\\\",\\n        \\\"--target\\\",\\n        telegram_target,\\n        \\\"--media\\\",\\n        str(temp_path_obj),\\n    ]\\n    try:\\n        subprocess.run(command, check=True)\\n    except subprocess.CalledProcessError as exc:\\n        raise RuntimeError(f\\\"Failed to send image to Telegram target {telegram_target}: {exc}\\\") from exc\\n\\n\\ndef main():\\n\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":168,"output":786,"cacheRead":17536,"cacheWrite":0,"totalTokens":18490,"cost":{"input":0.00042,"output":0.01179,"cacheRead":0.004384,"cacheWrite":0,"total":0.016594}},"stopReason":"toolUse","timestamp":1773843658609}}
