{"type":"message","id":"a70a294f","parentId":"cc9e2f1b","timestamp":"2026-03-20T17:36:56.939Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_4ovFNaoexsIBiMDiapjxaQmv|fc_01ab9eaf5e5ca29e0169bd8573a99c8191a5ab6ad8b503967e","name":"write","arguments":{"file_path":"/home/node/.openclaw/skills/kidney-pipeline-execution/scripts/pipeline_execution_tool.py","content":"#!/usr/bin/env python3\nimport argparse\nimport copy\nimport json\nimport mimetypes\nimport os\nimport re\nimport sys\nfrom pathlib import Path\nfrom urllib import error, parse, request\n\nimport requests\n\nEXECUTION_ENDPOINT = (\n    \"http://looporchestra.sytes.net:4001/admin/prototype_execution/prototype_execution/\"\n)\nUPLOAD_BASE_URL = \"http://looporchestra.sytes.net:4001/nodes/input/upload\"\nFIXED_STORAGE_REF = \"nodes_template\"\nFIXED_LOCAL_FILE_PATH = \"upload\"\nSUPPORTED_EXTENSIONS = {\".jpg\", \".jpeg\", \".png\", \".gif\", \".webp\", \".bmp\", \".tif\", \".tiff\"}\n\nREQUEST_TEMPLATE_PATH = Path(__file__).resolve().parent.parent / \"references\" / \"request-template.json\"\nINBOUND_MEDIA_DIR = Path(\"/home/node/.openclaw/media/inbound\").resolve()\n\n\ndef _safe_suffix_from_url(url: str) -> str:\n    parsed = parse.urlparse(url)\n    suffix = Path(parsed.path).suffix.lower()\n    if suffix in SUPPORTED_EXTENSIONS:\n        return suffix\n    return \".jpg\"\n\n\ndef _extract_image_url_from_response(response_obj):\n    try:\n        file_path = response_obj[\"response\"][\"workflows\"][0][\"branches\"][0][\"nodes\"][0][\"children\"][0][\"children\"][0][\"tracking\"][\"parameters\"].get(\"file_path\")\n    except (KeyError, IndexError, TypeError):\n        return None\n\n    if not isinstance(file_path, str) or not file_path:\n        return None\n\n    match = re.search(r\"https?://\\S+\", file_path)\n    return match.group(0) if match else None\n\n\ndef _deep_get(obj, path, default=None):\n    current = obj\n    for key in path:\n        try:\n            current = current[key]\n        except (KeyError, IndexError, TypeError):\n            return default\n    return current\n\n\ndef _extract_module_reference_metrics(response_payload):\n    if not isinstance(response_payload, dict):\n        return None\n\n    kidney_detector = {\n        \"Inference time\": _deep_get(\n            response_payload,\n            [\"workflows\", 0, \"branches\", 0, \"nodes\", 0, \"children\", 0, \"tracking\", \"parameters\", \"Inference time\"],\n        ),\n        \"classes\": _deep_get(\n            response_payload,\n            [\"workflows\", 0, \"branches\", 0, \"nodes\", 0, \"children\", 0, \"tracking\", \"parameters\", \"classes\"],\n        ),\n        \"confidence\": _deep_get(\n            response_payload,\n            [\"workflows\", 0, \"branches\", 0, \"nodes\", 0, \"children\", 0, \"tracking\", \"parameters\", \"confidence\"],\n        ),\n    }\n    image_analyzer = {\n        \"cam_metrics\": _deep_get(\n            response_payload,\n            [\"workflows\", 0, \"branches\", 0, \"nodes\", 0, \"children\", 0, \"children\", 0, \"tracking\", \"parameters\", \"cam_metrics\"],\n        ),\n        \"prediction\": _deep_get(\n            response_payload,\n            [\"workflows\", 0, \"branches\", 0, \"nodes\", 0, \"children\", 0, \"children\", 0, \"tracking\", \"parameters\", \"prediction\"],\n        ),\n        \"cam_explanation\": _deep_get(\n            response_payload,\n            [\"workflows\", 0, \"branches\", 0, \"nodes\", 0, \"children\", 0, \"children\", 0, \"tracking\", \"parameters\", \"cam_explanation\"],\n        ),\n    }\n    xai = {\n        \"confidence_interpretation\": _deep_get(\n            response_payload,\n            [\"workflows\", 0, \"branches\", 0, \"nodes\", 0, \"children\", 0, \"children\", 0, \"children\", 0, \"tracking\", \"parameters\", \"confidence_interpretation\"],\n        ),\n        \"recommended_next_steps\": _deep_get(\n            response_payload,\n            [\"workflows\", 0, \"branches\", 0, \"nodes\", 0, \"children\", 0, \"children\", 0, \"children\", 0, \"tracking\", \"parameters\", \"recommended_next_steps\"],\n        ),\n        \"references\": _deep_get(\n            response_payload,\n            [\"workflows\", 0, \"branches\", 0, \"nodes\", 0, \"children\", 0, \"children\", 0, \"children\", 0, \"tracking\", \"parameters\", \"references\"],\n        ),\n        \"summary\": _deep_get(\n            response_payload,\n            [\"workflows\", 0, \"branches\", 0, \"nodes\", 0, \"children\", 0, \"children\", 0, \"children\", 0, \"tracking\", \"parameters\", \"summary\"],\n        ),\n        \"visual_evidence\": _deep_get(\n            response_payload,\n            [\"workflows\", 0, \"branches\", 0, \"nodes\", 0, \"children\", 0, \"children\", 0, \"children\", 0, \"tracking\", \"parameters\", \"visual_evidence\"],\n        ),\n    }\n\n    modules = {\n        \"kidney_cancer_detector\": kidney_detector,\n        \"image_analyzer\": image_analyzer,\n        \"xai\": xai,\n    }\n    if not any(value is not None for module in modules.values() for value in module.values()):\n        return None\n    return modules\n\n\ndef load_request_template():\n    try:\n        return json.loads(REQUEST_TEMPLATE_PATH.read_text(encoding=\"utf-8\"))\n    except FileNotFoundError as exc:\n        raise RuntimeError(f\"Request template file not found: {REQUEST_TEMPLATE_PATH}\") from exc\n    except json.JSONDecodeError as exc:\n        raise RuntimeError(\n            f\"Request template file is not valid JSON: {REQUEST_TEMPLATE_PATH}\"\n        ) from exc\n\n\ndef _normalize_upload_response(value):\n    if isinstance(value, list):\n        if not value:\n            raise RuntimeError(\"Upload response was an empty list.\")\n        value = value[0]\n    if not isinstance(value, dict):\n        raise RuntimeError(\"Upload endpoint returned an unsupported JSON shape.\")\n    return value\n\n\ndef _guess_mime_type(file_path: Path) -> str:\n    guessed, _ = mimetypes.guess_type(str(file_path))\n    return guessed or \"application/octet-stream\"\n\n\ndef upload_image(local_image_path: str, telegram_user_id: str, timeout: int = 60) -> dict:\n    file_path = Path(local_image_path).expanduser().resolve()\n    if not file_path.is_file():\n        raise RuntimeError(f\"Image file not found: {file_path}\")\n\n    params = {\n        \"storage_ref\": FIXED_STORAGE_REF,\n        \"local_file_path\": FIXED_LOCAL_FILE_PATH,\n        \"user_id\": str(telegram_user_id),\n    }\n    headers = {\n        \"accept\": \"application/json\",\n    }\n    mime_type = _guess_mime_type(file_path)\n\n    try:\n        with file_path.open(\"rb\") as fh:\n            response = requests.post(\n                UPLOAD_BASE_URL,\n                params=params,\n                headers=headers,\n                files={\"file\": (file_path.name, fh, mime_type)},\n                timeout=timeout,\n            )\n    except requests.Timeout as exc:\n        raise RuntimeError(f\"Upload request timed out after {timeout}s\") from exc\n    except requests.RequestException as exc:\n        raise RuntimeError(f\"Upload request failed: {exc}\") from exc\n\n    if not response.ok:\n        raise RuntimeError(\n            f\"Upload failed with HTTP {response.status_code}: {response.text[:500]}\"\n        )\n\n    try:\n        parsed = response.json()\n    except json.JSONDecodeError as exc:\n        raise RuntimeError(\n            f\"Upload endpoint returned a non-JSON response: {response.text[:500]}\"\n        ) from exc\n\n    parsed = _normalize_upload_response(parsed)\n    remote_dir = parsed.get(\"path\")\n    filename = parsed.get(\"filename\")\n    if not isinstance(remote_dir, str) or not remote_dir:\n        raise RuntimeError(\"Upload response is missing 'path'.\")\n    if not isinstance(filename, str) or not filename:\n        raise RuntimeError(\"Upload response is missing 'filename'.\")\n\n    upload_request_url = f\"{UPLOAD_BASE_URL}?{parse.urlencode(params)}\"\n    return {\n        \"uploaded_image_path\": f\"{remote_dir}{filename}\",\n        \"upload_path\": remote_dir,\n        \"upload_filename\": filename,\n        \"telegram_user_id_used\": str(telegram_user_id),\n        \"upload_request_url\": upload_request_url,\n        \"upload_request_params\": params,\n        \"raw_upload_response\": parsed,\n    }\n\n\nPATH_FIELD_KEYS = {\"filename\", \"pdf_path\", \"File Path\"}\n\n\ndef _looks_like_template_image_path(value: str) -> bool:\n    if value == \"<image_path_here>\":\n        return True\n    normalized = value.strip()\n    return normalized.startswith(\"upload/\") or normalized.startswith(\"/upload/\")\n\n\n\ndef _replace_uploaded_image_path(obj, uploaded_image_path: str, parent_key=None):\n    if isinstance(obj, dict):\n        return {\n            key: _replace_uploaded_image_path(value, uploaded_image_path, parent_key=key)\n            for key, value in obj.items()\n        }\n    if isinstance(obj, list):\n        return [\n            _replace_uploaded_image_path(item, uploaded_image_path, parent_key=parent_key)\n            for item in obj\n        ]\n    if isinstance(obj, str) and (\n        obj == \"<image_path_here>\"\n        or (parent_key in PATH_FIELD_KEYS and _looks_like_template_image_path(obj))\n    ):\n        return uploaded_image_path\n    return obj\n\n\n\ndef _assert_no_placeholder_path(payload_obj):\n    found = []\n\n    def _walk(value, path=\"root\"):\n        if isinstance(value, dict):\n            for key, child in value.items():\n                _walk(child, f\"{path}.{key}\")\n            return\n        if isinstance(value, list):\n            for index, child in enumerate(value):\n                _walk(child, f\"{path}[{index}]\")\n            return\n        if value == \"<image_path_here>\":\n            found.append(path)\n\n    _walk(payload_obj)\n    if found:\n        joined = \", \".join(found[:10])\n        raise RuntimeError(f\"Request payload still contains <image_path_here> at: {joined}\")\n\n\n\ndef build_payload(uploaded_image_path: str):\n    payload_obj = _replace_uploaded_image_path(copy.deepcopy(load_request_template()), uploaded_image_path)\n    _assert_no_placeholder_path(payload_obj)\n    return payload_obj\n\n\ndef call_pipeline_execution(uploaded_image_path: str, timeout: int = 120):\n    payload_obj = build_payload(uploaded_image_path)\n    payload = json.dumps(payload_obj).encode(\"utf-8\")\n    req = request.Request(\n        EXECUTION_ENDPOINT,\n        data=payload,\n        headers={\"Content-Type\": \"application/json\", \"Accept\": \"application/json\"},\n        method=\"POST\",\n    )\n\n    try:\n        with request.urlopen(req, timeout=timeout) as resp:\n            body = resp.read().decode(\"utf-8\", errors=\"replace\")\n            status = resp.status\n            content_type = resp.headers.get(\"Content-Type\", \"\")\n    except error.HTTPError as e:\n        detail = e.read().decode(\"utf-8\", errors=\"replace\")\n        raise RuntimeError(f\"Execution failed with HTTP {e.code}: {detail}\") from e\n    except Exception as e:\n        raise RuntimeError(f\"Execution request failed: {e}\") from e\n\n    parsed_body = None\n    try:\n        parsed_body = json.loads(body)\n    except json.JSONDecodeError:\n        parsed_body = body\n\n    result = {\n        \"uploaded_image_path\": uploaded_image_path,\n        \"endpoint\": EXECUTION_ENDPOINT,\n        \"http_status\": status,\n        \"content_type\": content_type,\n        \"response\": parsed_body,\n    }\n\n    module_reference_metrics = _extract_module_reference_metrics(parsed_body)\n    if module_reference_metrics is not None:\n        result[\"module_reference_metrics\"] = module_reference_metrics\n\n    image_url = _extract_image_url_from_response(result)\n    result[\"analyzer_image_url\"] = image_url\n    result[\"sent_result_image\"] = False\n    return result\n\n\ndef find_latest_inbound_image() -> str:\n    if not INBOUND_MEDIA_DIR.is_dir():\n        raise RuntimeError(\n            \"Inbound media directory not found: /home/node/.openclaw/media/inbound. \"\n            \"Pass --image-path explicitly if the image is stored elsewhere.\"\n        )\n\n    candidates = [\n        path\n        for path in INBOUND_MEDIA_DIR.rglob(\"*\")\n        if path.is_file() and path.suffix.lower() in SUPPORTED_EXTENSIONS\n    ]\n    if not candidates:\n        raise RuntimeError(\n            \"No supported image files found in /home/node/.openclaw/media/inbound. \"\n            \"Pass --image-path explicitly if needed.\"\n        )\n\n    latest = max(candidates, key=lambda p: p.stat().st_mtime)\n    return str(latest)\n\n\ndef main():\n    parser = argparse.ArgumentParser(\n        description=(\n            \"Upload a local image with the kidney cancer skill's requests-based multipart flow, \"\n            \"replace the <image_path_here> placeholder inside the fixed prototype payload, call the \"\n            \"prototype execution endpoint, expose any analyzer image URL in the JSON wrapper, \"\n            \"and print the result without sending out-of-band Telegram messages.\"\n        )\n    )\n    parser.add_argument(\n        \"image_path\",\n        nargs=\"?\",\n        help=(\n            \"Local image path to upload first. If omitted, the tool selects the most \"\n            \"recent supported image from /home/node/.openclaw/media/inbound.\"\n        ),\n    )\n    parser.add_argument(\n        \"--telegram-user-id\",\n        default=os.environ.get(\"TELEGRAM_USER_ID\"),\n        help=\"Telegram user id used as the upload endpoint's user_id query parameter.\",\n    )\n    parser.add_argument(\"--timeout\", type=int, default=120, help=\"Execution timeout in seconds.\")\n    parser.add_argument(\"--upload-timeout\", type=int, default=60, help=\"Upload timeout in seconds.\")\n    args = parser.parse_args()\n\n    if not args.telegram_user_id:\n        raise RuntimeError(\n            \"Missing Telegram user id. Pass --telegram-user-id or set TELEGRAM_USER_ID.\"\n        )\n\n    local_image_path = args.image_path or find_latest_inbound_image()\n    telegram_user_id = str(args.telegram_user_id)\n\n    upload_result = upload_image(\n        local_image_path=local_image_path,\n        telegram_user_id=telegram_user_id,\n        timeout=args.upload_timeout,\n    )\n    result = call_pipeline_execution(\n        upload_result[\"uploaded_image_path\"],\n        timeout=args.timeout,\n    )\n    result[\"local_image_path_used\"] = str(Path(local_image_path).expanduser().resolve())\n    result[\"telegram_user_id_used_for_upload\"] = upload_result[\"telegram_user_id_used\"]\n    result[\"upload_path\"] = upload_result[\"upload_path\"]\n    result[\"upload_filename\"] = upload_result[\"upload_filename\"]\n    result[\"upload_request_url\"] = upload_result[\"upload_request_url\"]\n    result[\"upload_request_params\"] = upload_result[\"upload_request_params\"]\n    result[\"raw_upload_response\"] = upload_result[\"raw_upload_response\"]\n    print(json.dumps(result, indent=2, ensure_ascii=False))\n\n\nif __name__ == \"__main__\":\n    try:\n        main()\n    except Exception as exc:\n        print(f\"ERROR: {exc}\", file=sys.stderr)\n        sys.exit(1)\n"},"partialJson":"{\"file_path\":\"/home/node/.openclaw/skills/kidney-pipeline-execution/scripts/pipeline_execution_tool.py\",\"content\":\"#!/usr/bin/env python3\\nimport argparse\\nimport copy\\nimport json\\nimport mimetypes\\nimport os\\nimport re\\nimport sys\\nfrom pathlib import Path\\nfrom urllib import error, parse, request\\n\\nimport requests\\n\\nEXECUTION_ENDPOINT = (\\n    \\\"http://looporchestra.sytes.net:4001/admin/prototype_execution/prototype_execution/\\\"\\n)\\nUPLOAD_BASE_URL = \\\"http://looporchestra.sytes.net:4001/nodes/input/upload\\\"\\nFIXED_STORAGE_REF = \\\"nodes_template\\\"\\nFIXED_LOCAL_FILE_PATH = \\\"upload\\\"\\nSUPPORTED_EXTENSIONS = {\\\".jpg\\\", \\\".jpeg\\\", \\\".png\\\", \\\".gif\\\", \\\".webp\\\", \\\".bmp\\\", \\\".tif\\\", \\\".tiff\\\"}\\n\\nREQUEST_TEMPLATE_PATH = Path(__file__).resolve().parent.parent / \\\"references\\\" / \\\"request-template.json\\\"\\nINBOUND_MEDIA_DIR = Path(\\\"/home/node/.openclaw/media/inbound\\\").resolve()\\n\\n\\ndef _safe_suffix_from_url(url: str) -> str:\\n    parsed = parse.urlparse(url)\\n    suffix = Path(parsed.path).suffix.lower()\\n    if suffix in SUPPORTED_EXTENSIONS:\\n        return suffix\\n    return \\\".jpg\\\"\\n\\n\\ndef _extract_image_url_from_response(response_obj):\\n    try:\\n        file_path = response_obj[\\\"response\\\"][\\\"workflows\\\"][0][\\\"branches\\\"][0][\\\"nodes\\\"][0][\\\"children\\\"][0][\\\"children\\\"][0][\\\"tracking\\\"][\\\"parameters\\\"].get(\\\"file_path\\\")\\n    except (KeyError, IndexError, TypeError):\\n        return None\\n\\n    if not isinstance(file_path, str) or not file_path:\\n        return None\\n\\n    match = re.search(r\\\"https?://\\\\S+\\\", file_path)\\n    return match.group(0) if match else None\\n\\n\\ndef _deep_get(obj, path, default=None):\\n    current = obj\\n    for key in path:\\n        try:\\n            current = current[key]\\n        except (KeyError, IndexError, TypeError):\\n            return default\\n    return current\\n\\n\\ndef _extract_module_reference_metrics(response_payload):\\n    if not isinstance(response_payload, dict):\\n        return None\\n\\n    kidney_detector = {\\n        \\\"Inference time\\\": _deep_get(\\n            response_payload,\\n            [\\\"workflows\\\", 0, \\\"branches\\\", 0, \\\"nodes\\\", 0, \\\"children\\\", 0, \\\"tracking\\\", \\\"parameters\\\", \\\"Inference time\\\"],\\n        ),\\n        \\\"classes\\\": _deep_get(\\n            response_payload,\\n            [\\\"workflows\\\", 0, \\\"branches\\\", 0, \\\"nodes\\\", 0, \\\"children\\\", 0, \\\"tracking\\\", \\\"parameters\\\", \\\"classes\\\"],\\n        ),\\n        \\\"confidence\\\": _deep_get(\\n            response_payload,\\n            [\\\"workflows\\\", 0, \\\"branches\\\", 0, \\\"nodes\\\", 0, \\\"children\\\", 0, \\\"tracking\\\", \\\"parameters\\\", \\\"confidence\\\"],\\n        ),\\n    }\\n    image_analyzer = {\\n        \\\"cam_metrics\\\": _deep_get(\\n            response_payload,\\n            [\\\"workflows\\\", 0, \\\"branches\\\", 0, \\\"nodes\\\", 0, \\\"children\\\", 0, \\\"children\\\", 0, \\\"tracking\\\", \\\"parameters\\\", \\\"cam_metrics\\\"],\\n        ),\\n        \\\"prediction\\\": _deep_get(\\n            response_payload,\\n            [\\\"workflows\\\", 0, \\\"branches\\\", 0, \\\"nodes\\\", 0, \\\"children\\\", 0, \\\"children\\\", 0, \\\"tracking\\\", \\\"parameters\\\", \\\"prediction\\\"],\\n        ),\\n        \\\"cam_explanation\\\": _deep_get(\\n            response_payload,\\n            [\\\"workflows\\\", 0, \\\"branches\\\", 0, \\\"nodes\\\", 0, \\\"children\\\", 0, \\\"children\\\", 0, \\\"tracking\\\", \\\"parameters\\\", \\\"cam_explanation\\\"],\\n        ),\\n    }\\n    xai = {\\n        \\\"confidence_interpretation\\\": _deep_get(\\n            response_payload,\\n            [\\\"workflows\\\", 0, \\\"branches\\\", 0, \\\"nodes\\\", 0, \\\"children\\\", 0, \\\"children\\\", 0, \\\"children\\\", 0, \\\"tracking\\\", \\\"parameters\\\", \\\"confidence_interpretation\\\"],\\n        ),\\n        \\\"recommended_next_steps\\\": _deep_get(\\n            response_payload,\\n            [\\\"workflows\\\", 0, \\\"branches\\\", 0, \\\"nodes\\\", 0, \\\"children\\\", 0, \\\"children\\\", 0, \\\"children\\\", 0, \\\"tracking\\\", \\\"parameters\\\", \\\"recommended_next_steps\\\"],\\n        ),\\n        \\\"references\\\": _deep_get(\\n            response_payload,\\n            [\\\"workflows\\\", 0, \\\"branches\\\", 0, \\\"nodes\\\", 0, \\\"children\\\", 0, \\\"children\\\", 0, \\\"children\\\", 0, \\\"tracking\\\", \\\"parameters\\\", \\\"references\\\"],\\n        ),\\n        \\\"summary\\\": _deep_get(\\n            response_payload,\\n            [\\\"workflows\\\", 0, \\\"branches\\\", 0, \\\"nodes\\\", 0, \\\"children\\\", 0, \\\"children\\\", 0, \\\"children\\\", 0, \\\"tracking\\\", \\\"parameters\\\", \\\"summary\\\"],\\n        ),\\n        \\\"visual_evidence\\\": _deep_get(\\n            response_payload,\\n            [\\\"workflows\\\", 0, \\\"branches\\\", 0, \\\"nodes\\\", 0, \\\"children\\\", 0, \\\"children\\\", 0, \\\"children\\\", 0, \\\"tracking\\\", \\\"parameters\\\", \\\"visual_evidence\\\"],\\n        ),\\n    }\\n\\n    modules = {\\n        \\\"kidney_cancer_detector\\\": kidney_detector,\\n        \\\"image_analyzer\\\": image_analyzer,\\n        \\\"xai\\\": xai,\\n    }\\n    if not any(value is not None for module in modules.values() for value in module.values()):\\n        return None\\n    return modules\\n\\n\\ndef load_request_template():\\n    try:\\n        return json.loads(REQUEST_TEMPLATE_PATH.read_text(encoding=\\\"utf-8\\\"))\\n    except FileNotFoundError as exc:\\n        raise RuntimeError(f\\\"Request template file not found: {REQUEST_TEMPLATE_PATH}\\\") from exc\\n    except json.JSONDecodeError as exc:\\n        raise RuntimeError(\\n            f\\\"Request template file is not valid JSON: {REQUEST_TEMPLATE_PATH}\\\"\\n        ) from exc\\n\\n\\ndef _normalize_upload_response(value):\\n    if isinstance(value, list):\\n        if not value:\\n            raise RuntimeError(\\\"Upload response was an empty list.\\\")\\n        value = value[0]\\n    if not isinstance(value, dict):\\n        raise RuntimeError(\\\"Upload endpoint returned an unsupported JSON shape.\\\")\\n    return value\\n\\n\\ndef _guess_mime_type(file_path: Path) -> str:\\n    guessed, _ = mimetypes.guess_type(str(file_path))\\n    return guessed or \\\"application/octet-stream\\\"\\n\\n\\ndef upload_image(local_image_path: str, telegram_user_id: str, timeout: int = 60) -> dict:\\n    file_path = Path(local_image_path).expanduser().resolve()\\n    if not file_path.is_file():\\n        raise RuntimeError(f\\\"Image file not found: {file_path}\\\")\\n\\n    params = {\\n        \\\"storage_ref\\\": FIXED_STORAGE_REF,\\n        \\\"local_file_path\\\": FIXED_LOCAL_FILE_PATH,\\n        \\\"user_id\\\": str(telegram_user_id),\\n    }\\n    headers = {\\n        \\\"accept\\\": \\\"application/json\\\",\\n    }\\n    mime_type = _guess_mime_type(file_path)\\n\\n    try:\\n        with file_path.open(\\\"rb\\\") as fh:\\n            response = requests.post(\\n                UPLOAD_BASE_URL,\\n                params=params,\\n                headers=headers,\\n                files={\\\"file\\\": (file_path.name, fh, mime_type)},\\n                timeout=timeout,\\n            )\\n    except requests.Timeout as exc:\\n        raise RuntimeError(f\\\"Upload request timed out after {timeout}s\\\") from exc\\n    except requests.RequestException as exc:\\n        raise RuntimeError(f\\\"Upload request failed: {exc}\\\") from exc\\n\\n    if not response.ok:\\n        raise RuntimeError(\\n            f\\\"Upload failed with HTTP {response.status_code}: {response.text[:500]}\\\"\\n        )\\n\\n    try:\\n        parsed = response.json()\\n    except json.JSONDecodeError as exc:\\n        raise RuntimeError(\\n            f\\\"Upload endpoint returned a non-JSON response: {response.text[:500]}\\\"\\n        ) from exc\\n\\n    parsed = _normalize_upload_response(parsed)\\n    remote_dir = parsed.get(\\\"path\\\")\\n    filename = parsed.get(\\\"filename\\\")\\n    if not isinstance(remote_dir, str) or not remote_dir:\\n        raise RuntimeError(\\\"Upload response is missing 'path'.\\\")\\n    if not isinstance(filename, str) or not filename:\\n        raise RuntimeError(\\\"Upload response is missing 'filename'.\\\")\\n\\n    upload_request_url = f\\\"{UPLOAD_BASE_URL}?{parse.urlencode(params)}\\\"\\n    return {\\n        \\\"uploaded_image_path\\\": f\\\"{remote_dir}{filename}\\\",\\n        \\\"upload_path\\\": remote_dir,\\n        \\\"upload_filename\\\": filename,\\n        \\\"telegram_user_id_used\\\": str(telegram_user_id),\\n        \\\"upload_request_url\\\": upload_request_url,\\n        \\\"upload_request_params\\\": params,\\n        \\\"raw_upload_response\\\": parsed,\\n    }\\n\\n\\nPATH_FIELD_KEYS = {\\\"filename\\\", \\\"pdf_path\\\", \\\"File Path\\\"}\\n\\n\\ndef _looks_like_template_image_path(value: str) -> bool:\\n    if value == \\\"<image_path_here>\\\":\\n        return True\\n    normalized = value.strip()\\n    return normalized.startswith(\\\"upload/\\\") or normalized.startswith(\\\"/upload/\\\")\\n\\n\\n\\ndef _replace_uploaded_image_path(obj, uploaded_image_path: str, parent_key=None):\\n    if isinstance(obj, dict):\\n        return {\\n            key: _replace_uploaded_image_path(value, uploaded_image_path, parent_key=key)\\n            for key, value in obj.items()\\n        }\\n    if isinstance(obj, list):\\n        return [\\n            _replace_uploaded_image_path(item, uploaded_image_path, parent_key=parent_key)\\n            for item in obj\\n        ]\\n    if isinstance(obj, str) and (\\n        obj == \\\"<image_path_here>\\\"\\n        or (parent_key in PATH_FIELD_KEYS and _looks_like_template_image_path(obj))\\n    ):\\n        return uploaded_image_path\\n    return obj\\n\\n\\n\\ndef _assert_no_placeholder_path(payload_obj):\\n    found = []\\n\\n    def _walk(value, path=\\\"root\\\"):\\n        if isinstance(value, dict):\\n            for key, child in value.items():\\n                _walk(child, f\\\"{path}.{key}\\\")\\n            return\\n        if isinstance(value, list):\\n            for index, child in enumerate(value):\\n                _walk(child, f\\\"{path}[{index}]\\\")\\n            return\\n        if value == \\\"<image_path_here>\\\":\\n            found.append(path)\\n\\n    _walk(payload_obj)\\n    if found:\\n        joined = \\\", \\\".join(found[:10])\\n        raise RuntimeError(f\\\"Request payload still contains <image_path_here> at: {joined}\\\")\\n\\n\\n\\ndef build_payload(uploaded_image_path: str):\\n    payload_obj = _replace_uploaded_image_path(copy.deepcopy(load_request_template()), uploaded_image_path)\\n    _assert_no_placeholder_path(payload_obj)\\n    return payload_obj\\n\\n\\ndef call_pipeline_execution(uploaded_image_path: str, timeout: int = 120):\\n    payload_obj = build_payload(uploaded_image_path)\\n    payload = json.dumps(payload_obj).encode(\\\"utf-8\\\")\\n    req = request.Request(\\n        EXECUTION_ENDPOINT,\\n        data=payload,\\n        headers={\\\"Content-Type\\\": \\\"application/json\\\", \\\"Accept\\\": \\\"application/json\\\"},\\n        method=\\\"POST\\\",\\n    )\\n\\n    try:\\n        with request.urlopen(req, timeout=timeout) as resp:\\n            body = resp.read().decode(\\\"utf-8\\\", errors=\\\"replace\\\")\\n            status = resp.status\\n            content_type = resp.headers.get(\\\"Content-Type\\\", \\\"\\\")\\n    except error.HTTPError as e:\\n        detail = e.read().decode(\\\"utf-8\\\", errors=\\\"replace\\\")\\n        raise RuntimeError(f\\\"Execution failed with HTTP {e.code}: {detail}\\\") from e\\n    except Exception as e:\\n        raise RuntimeError(f\\\"Execution request failed: {e}\\\") from e\\n\\n    parsed_body = None\\n    try:\\n        parsed_body = json.loads(body)\\n    except json.JSONDecodeError:\\n        parsed_body = body\\n\\n    result = {\\n        \\\"uploaded_image_path\\\": uploaded_image_path,\\n        \\\"endpoint\\\": EXECUTION_ENDPOINT,\\n        \\\"http_status\\\": status,\\n        \\\"content_type\\\": content_type,\\n        \\\"response\\\": parsed_body,\\n    }\\n\\n    module_reference_metrics = _extract_module_reference_metrics(parsed_body)\\n    if module_reference_metrics is not None:\\n        result[\\\"module_reference_metrics\\\"] = module_reference_metrics\\n\\n    image_url = _extract_image_url_from_response(result)\\n    result[\\\"analyzer_image_url\\\"] = image_url\\n    result[\\\"sent_result_image\\\"] = False\\n    return result\\n\\n\\ndef find_latest_inbound_image() -> str:\\n    if not INBOUND_MEDIA_DIR.is_dir():\\n        raise RuntimeError(\\n            \\\"Inbound media directory not found: /home/node/.openclaw/media/inbound. \\\"\\n            \\\"Pass --image-path explicitly if the image is stored elsewhere.\\\"\\n        )\\n\\n    candidates = [\\n        path\\n        for path in INBOUND_MEDIA_DIR.rglob(\\\"*\\\")\\n        if path.is_file() and path.suffix.lower() in SUPPORTED_EXTENSIONS\\n    ]\\n    if not candidates:\\n        raise RuntimeError(\\n            \\\"No supported image files found in /home/node/.openclaw/media/inbound. \\\"\\n            \\\"Pass --image-path explicitly if needed.\\\"\\n        )\\n\\n    latest = max(candidates, key=lambda p: p.stat().st_mtime)\\n    return str(latest)\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser(\\n        description=(\\n            \\\"Upload a local image with the kidney cancer skill's requests-based multipart flow, \\\"\\n            \\\"replace the <image_path_here> placeholder inside the fixed prototype payload, call the \\\"\\n            \\\"prototype execution endpoint, expose any analyzer image URL in the JSON wrapper, \\\"\\n            \\\"and print the result without sending out-of-band Telegram messages.\\\"\\n        )\\n    )\\n    parser.add_argument(\\n        \\\"image_path\\\",\\n        nargs=\\\"?\\\",\\n        help=(\\n            \\\"Local image path to upload first. If omitted, the tool selects the most \\\"\\n            \\\"recent supported image from /home/node/.openclaw/media/inbound.\\\"\\n        ),\\n    )\\n    parser.add_argument(\\n        \\\"--telegram-user-id\\\",\\n        default=os.environ.get(\\\"TELEGRAM_USER_ID\\\"),\\n        help=\\\"Telegram user id used as the upload endpoint's user_id query parameter.\\\",\\n    )\\n    parser.add_argument(\\\"--timeout\\\", type=int, default=120, help=\\\"Execution timeout in seconds.\\\")\\n    parser.add_argument(\\\"--upload-timeout\\\", type=int, default=60, help=\\\"Upload timeout in seconds.\\\")\\n    args = parser.parse_args()\\n\\n    if not args.telegram_user_id:\\n        raise RuntimeError(\\n            \\\"Missing Telegram user id. Pass --telegram-user-id or set TELEGRAM_USER_ID.\\\"\\n        )\\n\\n    local_image_path = args.image_path or find_latest_inbound_image()\\n    telegram_user_id = str(args.telegram_user_id)\\n\\n    upload_result = upload_image(\\n        local_image_path=local_image_path,\\n        telegram_user_id=telegram_user_id,\\n        timeout=args.upload_timeout,\\n    )\\n    result = call_pipeline_execution(\\n        upload_result[\\\"uploaded_image_path\\\"],\\n        timeout=args.timeout,\\n    )\\n    result[\\\"local_image_path_used\\\"] = str(Path(local_image_path).expanduser().resolve())\\n    result[\\\"telegram_user_id_used_for_upload\\\"] = upload_result[\\\"telegram_user_id_used\\\"]\\n    result[\\\"upload_path\\\"] = upload_result[\\\"upload_path\\\"]\\n    result[\\\"upload_filename\\\"] = upload_result[\\\"upload_filename\\\"]\\n    result[\\\"upload_request_url\\\"] = upload_result[\\\"upload_request_url\\\"]\\n    result[\\\"upload_request_params\\\"] = upload_result[\\\"upload_request_params\\\"]\\n    result[\\\"raw_upload_response\\\"] = upload_result[\\\"raw_upload_response\\\"]\\n    print(json.dumps(result, indent=2, ensure_ascii=False))\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    try:\\n        main()\\n    except Exception as exc:\\n        print(f\\\"ERROR: {exc}\\\", file=sys.stderr)\\n        sys.exit(1)\\n\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":293,"output":3852,"cacheRead":18176,"cacheWrite":0,"totalTokens":22321,"cost":{"input":0.0007325000000000001,"output":0.05778,"cacheRead":0.004543999999999999,"cacheWrite":0,"total":0.06305649999999999}},"stopRea