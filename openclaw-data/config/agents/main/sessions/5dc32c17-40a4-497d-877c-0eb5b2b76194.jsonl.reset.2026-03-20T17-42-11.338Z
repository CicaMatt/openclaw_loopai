': 'nodes_template',\n    'local_file_path': 'upload',\n    'user_id': '495506013',\n}\nurl = 'http://looporchestra.sytes.net:4001/nodes/input/upload?' + parse.urlencode(params)\nmime = mimetypes.guess_type(str(file_path))[0] or 'application/octet-stream'\nboundary = '----OpenClawBoundary' + uuid.uuid4().hex\nbody = b''.join([\n    f'--{boundary}\\r\\n'.encode(),\n    f'Content-Disposition: form-data; name=\"file\"; filename=\"{file_path.name}\"\\r\\n'.encode(),\n    f'Content-Type: {mime}\\r\\n\\r\\n'.encode(),\n    file_path.read_bytes(),\n    b'\\r\\n',\n    f'--{boundary}--\\r\\n'.encode(),\n])\nreq = request.Request(url, data=body, headers={'accept':'application/json','Content-Type': f'multipart/form-data; boundary={boundary}','Content-Length': str(len(body))}, method='POST')\ntry:\n    with request.urlopen(req, timeout=120) as resp:\n        txt = resp.read().decode('utf-8', errors='replace')\n        print('STATUS', resp.status)\n        print(txt)\nexcept error.HTTPError as e:\n    print('HTTP', e.code)\n    print(e.read().decode('utf-8', errors='replace'))\nPY","workdir":"/home/node/.openclaw/workspace","yieldMs":1000,"timeout":240},"partialJson":"{\"command\":\"python3 - <<'PY'\\nfrom pathlib import Path\\nimport json, mimetypes, uuid\\nfrom urllib import parse, request, error\\n\\nfile_path = Path('/home/node/.openclaw/media/inbound/file_3---c741e92d-038c-4902-a998-8a4ab312bb2c.jpg').resolve()\\nparams = {\\n    'storage_ref': 'nodes_template',\\n    'local_file_path': 'upload',\\n    'user_id': '495506013',\\n}\\nurl = 'http://looporchestra.sytes.net:4001/nodes/input/upload?' + parse.urlencode(params)\\nmime = mimetypes.guess_type(str(file_path))[0] or 'application/octet-stream'\\nboundary = '----OpenClawBoundary' + uuid.uuid4().hex\\nbody = b''.join([\\n    f'--{boundary}\\\\r\\\\n'.encode(),\\n    f'Content-Disposition: form-data; name=\\\"file\\\"; filename=\\\"{file_path.name}\\\"\\\\r\\\\n'.encode(),\\n    f'Content-Type: {mime}\\\\r\\\\n\\\\r\\\\n'