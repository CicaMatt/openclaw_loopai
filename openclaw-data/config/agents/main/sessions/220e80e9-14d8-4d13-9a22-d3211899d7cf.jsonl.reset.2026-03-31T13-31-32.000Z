ath, parent_key=key)', '_replace_uploaded_audio_path(value, uploaded_audio_path, parent_key=key)')\\nscript = script.replace('_replace_uploaded_image_path(item, uploaded_image_path, parent_key=parent_key)', '_replace_uploaded_audio_path(item, uploaded_audio_path, parent_key=parent_key)')\\nscript = script.replace('return uploaded_image_path', 'return uploaded_audio_path')\\nscript = script.replace('def build_payload(uploaded_image_path: str):\\\\n    payload_obj = _replace_uploaded_image_path(copy.deepcopy(load_request_template()), uploaded_image_path)', 'def build_payload(uploaded_audio_path: str):\\\\n    payload_obj = _replace_uploaded_audio_path(copy.deepcopy(load_request_template()), uploaded_audio_path)')\\nscript = script.replace('def call_pipeline_execution(uploaded_image_path: str, timeout: int = 120):\\\\n    payload_obj = build_payload(uploaded_image_path)', 'def call_pipeline_execution(uploaded_audio_path: str, timeout: int = 120):\\\\n    payload_obj = build_payload(uploaded_audio_path)')\\nscript = script.replace('\\\"uploaded_image_path\\\": uploaded_image_path,', '\\\"uploaded_audio_path\\\": uploaded_audio_path,')\\nscript = script.replace('    image_url = _extract_image_url_from_response(result)\\\\n    result[\\\"analyzer_image_url\\\"] = image_url\\\\n    result[\\\"sent_result_image\\\"] = False\\\\n', '')\\nscript = script.replace('def find_latest_inbound_image() -> str:', 'def find_latest_inbound_audio() -> str:')\\nscript = script.replace('No supported image files found', 'No supported audio files found')\\nscript = script.replace('Pass --image-path explicitly if needed.', 'Pass --audio-path explicitly if needed.')\\nscript = script.replace('def main():\\\\n    parser = argparse.ArgumentParser(\\\\n        description=(\\\\n            \\\"Upload a local image with the same flow as the kidney cancer skill, replace \\\"\\\\n            \\\"the <image_path_here> placeholder inside the fixed prototype payload, call the \\\"\\\\n            \\\"prototype execution endpoint, expose any analyzer image URL in the JSON wrapper, \\\"\\\\n            \\\"and print the result without sending out-of-band Telegram messages.\\\"\\\\n        )\\\\n    )\\\\n    parser.add_argument(\\\\n        \\\"image_path\\\",', 'def main():\\\\n    parser = argparse.ArgumentParser(\\\\n        description=(\\\\n            \\\"Upload a local audio file, replace the <image_path_here> placeholder inside the fixed \\\"\\\\n            \\\"prototype payload with the real uploaded audio path, call the shared prototype execution \\\"\\\\n            \\\"endpoint, and print the JSON wrapper without sending out-of-band Telegram messages.\\\"\\\\n        )\\\\n    )\\\\n    parser.add_argument(\\\\n        \\\"audio_path\\\",')\\nscript = script.replace('\\\"Local image path to upload first. If omitted, the tool selects the most \\\"\\\\n            \\\"recent supported image from /home/node/.openclaw/media/inbound.\\\"', '\\\"Local audio path to upload first. If omitted, the tool selects the most \\\"\\\\n            \\\"recent supported audio file from /home/node/.openclaw/media/inbound.\\\"')\\nscript = script.replace('local_image_path = args.image_path or find_latest_inbound_image()', 'local_audio_path = args.audio_path or find_latest_inbound_audio()')\\nscript = script.replace('upload_result = upload_image(\\\\n        local_image_path=local_image_path,', 'upload_result = upload_audio(\\\\n        local_audio_path=local_audio_path,')\\nscript = script.replace('        upload_result[\\\"uploaded_image_path\\\"],', '        upload_result[\\\"uploaded_audio_path\\\"],')\\nscript = script.replace('result[\\\"local_image_path_used\\\"] = str(Path(local_image_path).expanduser().resolve())', 'result[\\\"local_audio_path_used\\\"] = str(Path(local_audio_path).expanduser().resolve())')\\nscript = script.replace('replace \\\\\\\"the <image_path_here> placeholder', 'replace the <image_path_here> placeholder')\\nPath('/home/node/.openclaw/skills/depression-pipeline/scripts/pipeline_execution_tool.py').write_text(script, encoding='utf-8')\\nprint('script written')\\nPY\",\"yieldMs\":10000}"},{"type":"toolCall","id":"call_6V4A1Y6xZjKje7hy3ooE0KrH|fc_077b4823a0da81ec0169cbcb66d6108191a8d8fc3ab141d8dd","name":"write","arguments":{"file_path":"/home/node/.openclaw/skills/depression-pipeline/SKILL.md","content":"---\nname: depression-pipeline\ndescription: Execute the voice depression pipeline by uploading a user-provided audio file, taking the real uploaded file path returned by the shared upload endpoint, replacing the <image-path-here> placeholder inside the fixed prototype request JSON, then sending the built request to the shared prototype execution endpoint and summarizing the Voice Depression Detection and Fuzzy Stress Evaluator outputs. Use when a user wants to run the depression audio pipeline on a chat-provided audio file and inspect either the raw response or a clean summary of the main outputs.\n---\n\n# Depression Pipeline\n\nUpload the user audio first, use the returned upload path in the fixed request template, then execute the depression pipeline.\n\n## Required behavior\n\nFollow this sequence exactly:\n\n1. Determine the local audio file to analyze.\n   - Prefer the explicit user-provided local audio path.\n   - If no path is provided, use the newest supported audio file under `/home/node/.openclaw/media/inbound`.\n2. Require the Telegram user id.\n   - Pass it as `--telegram-user-id` or set `TELEGRAM_USER_ID`.\n   - Use that value as the upload request's `user_id` query parameter.\n3. Upload the audio with `POST multipart/form-data` to:\n   - `http://looporchestra.sytes.net:4001/nodes/input/upload?storage_ref=nodes_bucket&local_file_path=upload%2F&user_id=<telegram-user-id>`\n4. Read the upload response JSON.\n   - Build the real remote audio path as `path + filename`.\n   - Use the returned path from the upload response only.\n   - Do not keep example paths, stale upload paths, or unresolved placeholders in the executed request.\n5. Load `references/request-template.json`.\n6. Replace every `<image-path-here>` placeholder in the template with the real uploaded audio path.\n7. Send the resulting JSON payload to:\n   - `http://looporchestra.sytes.net:4001/admin/prototype_execution/prototype_execution/`\n8. Read the pipeline response and summarize it by module:\n   - Voice Depression Detection\n   - Fuzzy Stress Evaluator\n9. Do not send out-of-band Telegram messages from the script.\n10. Do not try to send any image back in chat for this skill.\n\n## Fixed values\n\nKeep these values fixed:\n- `storage_ref`: `nodes_bucket`\n- `local_file_path`: `upload/`\n- execution endpoint: `http://looporchestra.sytes.net:4001/admin/prototype_execution/prototype_execution/`\n- request template: `references/request-template.json`\n\n## Implementation notes\n\n- Treat the request template as a fixed prototype payload, but always inject the freshly uploaded audio path before execution.\n- Fail loudly if `<image_path_here>` remains anywhere in the payload after replacement.\n- If template fields such as `filename`, `pdf_path`, or `File Path` contain placeholder or stale upload-path values, replace them with the fresh uploaded audio path before execution.\n- Preserve the response wrapper shape returned by the script.\n- If the endpoint returns non-JSON text, return that text as the `response` value.\n\n## Preferred script\n\nRun:\n\n```bash\npython3 scripts/pipeline_execution_tool.py --telegram-user-id <telegram-user-id> [local-audio-path]\n```\n\nIf `local-audio-path` is omitted, the script should select the newest supported audio file from `/home/node/.openclaw/media/inbound`.\n\n## Summary fields to prioritize\n\nWhen present, summarize these fields first.\n\n### Voice Depression Detection\n- `Inference time`\n- `classes`\n- `confidence`\n- other returned tracking parameters when useful\n\n### Fuzzy Stress Evaluator\n- returned tracking parameters\n- any stress label, score, confidence, or explanation fields when present\n\n## User-facing reply rules\n\n- Group the result into the two modules.\n- Use readable labels instead of raw JSON paths.\n- Do not include low-level execution metadata by default.\n- Mention clearly that the pipeline output is a preliminary signal, not a diagnosis.\n- Do not attach or send any image in the normal reply for this skill.\n"},"partialJson":"{\"file_path\":\"/home/node/.openclaw/skills/depression-pipeline/SKILL.md\",\"content\":\"---\\nname: depression-pipeline\\ndescription: Execute the voice depression pipeline by uploading a user-provided audio file, taking the real uploaded file path returned by the shared upload endpoint, replacing the <image-path-here> placeholder inside the fixed prototype request JSON, then sending the built request to the shared prototype execution endpoint and summarizing the Voice Depression Detection and Fuzzy Stress Evaluator outputs. Use when a user wants to run the depression audio pipeline on a chat-provided audio file and inspect either the raw response or a clean summary of the main outputs.\\n---\\n\\n# Depression Pipeline\\n\\nUpload the user audio first, use the returned upload path in the fixed request template, then execute the depression pipeline.\\n\\n## Required behavior\\n\\nFollow this sequence exactly:\\n\\n1. Determine the local audio file to analyze.\\n   - Prefer the explicit user-provided local audio path.\\n   - If no path is provided, use the newest supported audio file under `/home/node/.openclaw/media/inbound`.\\n2. Require the Telegram user id.\\n   - Pass it as `--telegram-user-id` or set `TELEGRAM_USER_ID`.\\n   - Use that value as the upload request's `user_id` query parameter.\\n3. Upload the audio with `POST multipart/form-data` to:\\n   - `http://looporchestra.sytes.net:4001/nodes/input/upload?storage_ref=nodes_bucket&local_file_path=upload%2F&user_id=<telegram-user-id>`\\n4. Read the upload response JSON.\\n   - Build the real remote audio path as `path + filename`.\\n   - Use the returned path from the upload response only.\\n   - Do not keep example paths, stale upload paths, or unresolved placeholders in the executed request.\\n5. Load `references/request-template.json`.\\n6. Replace every `<image-path-here>` placeholder in the template with the real uploaded audio path.\\n7. Send the resulting JSON payload to:\\n   - `http://looporchestra.sytes.net:4001/admin/prototype_execution/prototype_execution/`\\n8. Read the pipeline response and summarize it by module:\\n   - Voice Depression Detection\\n   - Fuzzy Stress Evaluator\\n9. Do not send out-of-band Telegram messages from the script.\\n10. Do not try to send any image back in chat for this skill.\\n\\n## Fixed values\\n\\nKeep these values fixed:\\n- `storage_ref`: `nodes_bucket`\\n- `local_file_path`: `upload/`\\n- execution endpoint: `http://looporchestra.sytes.net:4001/admin/prototype_execution/prototype_execution/`\\n- request template: `references/request-template.json`\\n\\n## Implementation notes\\n\\n- Treat the request template as a fixed prototype payload, but always inject the freshly uploaded audio path before execution.\\n- Fail loudly if `<image_path_here>` remains anywhere in the payload after replacement.\\n- If template fields such as `filename`, `pdf_path`, or `File Path` contain placeholder or stale upload-path values, replace them with the fresh uploaded audio path before execution.\\n- Preserve the response wrapper shape returned by the script.\\n- If the endpoint returns non-JSON text, return that text as the `response` value.\\n\\n## Preferred script\\n\\nRun:\\n\\n```bash\\npython3 scripts/pipeline_execution_tool.py --telegram-user-id <telegram-user-id> [local-audio-path]\\n```\\n\\nIf `local-audio-path` is omitted, the script should select the newest supported audio file from `/home/node/.openclaw/media/inbound`.\\n\\n## Summary fields to prioritize\\n\\nWhen present, summarize these fields first.\\n\\n### Voice Depression Detection\\n- `Inference time`\\n- `classes`\\n- `confidence`\\n- other returned tracking parameters when useful\\n\\n### Fuzzy Stress Evaluator\\n- returned tracking parameters\\n- any stress label, score, confidence, or explanation fields when present\\n\\n## User-facing reply rules\\n\\n- Group the result into the two modules.\\n- Use readable labels instead of raw JSON paths.\\n- Do not include low-level execution metadata by default.\\n- Mention clearly that the pipeline output is a preliminary signal, not a diagnosis.\\n- Do not attach or send any image in the normal reply for this skill.\\n\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":4841,"output":3222,"cacheRead":27776,"cacheWrite":0,"totalTokens":35839,"cost":{"input":0.0121025,"output":0.04833,"cacheRead":0.006944,"cacheWrite":0,"total":0.0673765}},"stopReason":"toolUse","timestamp":1774963492480}}
