\n \"experiment_name\":\"string\",\n \"workflow_name\":\"string\",\n \"workflow_type\":\"experiment\",\n \"workflow_id\":\"string\",\n \"workflow_run_id\":\"string\",\n \"tags\":{\n \"additionalProp1\":\"string\",\n \"additionalProp2\":\"string\",\n \"additionalProp3\":\"string\"\n },\n \"parameters\":{\n \n },\n \"metrics\":{\n \n },\n \"artifacts\":{\n \"input_file\":true,\n \"output_file\":false,\n \"input_dataframe\":false,\n \"model_file\":false\n }\n },\n \"node_name_dict\":\"x_ai_model\",\n \"executed\":false,\n \"node_id\":\"6946dff31cc02c3427815ae2\"\n }\n ],\n \"tracking\":{\n \"run_id\":\"string\",\n \"start\":false,\n \"experiment_name\":\"string\",\n \"workflow_name\":\"string\",\n \"workflow_type\":\"experiment\",\n \"workflow_id\":\"string\",\n \"workflow_run_id\":\"string\",\n \"tags\":{\n \"additionalProp1\":\"string\",\n \"additionalProp2\":\"string\",\n \"additionalProp3\":\"string\"\n },\n \"parameters\":{\n \n },\n \"metrics\":{\n \n },\n \"artifacts\":{\n \"input_file\":true,\n \"output_file\":false,\n \"input_dataframe\":false,\n \"model_file\":false\n }\n },\n \"node_name_dict\":\"image_analyzer_model\",\n \"executed\":false,\n \"node_id\":\"6946db821cc02c3427815adf\"\n }\n ],\n \"tracking\":{\n \"run_id\":\"string\",\n \"start\":false,\n \"experiment_name\":\"string\",\n \"workflow_name\":\"string\",\n \"workflow_type\":\"experiment\",\n \"workflow_id\":\"string\",\n \"workflow_run_id\":\"string\",\n \"tags\":{\n \"additionalProp1\":\"string\",\n \"additionalProp2\":\"string\",\n \"additionalProp3\":\"string\"\n },\n \"parameters\":{\n \n },\n \"metrics\":{\n \n },\n \"artifacts\":{\n \"input_file\":true,\n \"output_file\":false,\n \"input_dataframe\":false,\n \"model_file\":false\n }\n },\n \"node_name_dict\":\"skin_cancer_detection_model\",\n \"executed\":false,\n \"node_id\":\"69368729b56d784128f4871a\"\n }\n ],\n \"tracking\":{\n \"run_id\":\"string\",\n \"start\":false,\n \"experiment_name\":\"string\",\n \"workflow_name\":\"string\",\n