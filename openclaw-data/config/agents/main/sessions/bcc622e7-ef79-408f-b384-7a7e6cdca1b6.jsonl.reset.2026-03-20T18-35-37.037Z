utput\"\n                     ],\n                     \"style\":{\n                        \"icon\":\"<svg width=\\\"19\\\" height=\\\"23\\\" viewBox=\\\"0 0 19 23\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n            <path d=\\\"M0.00173349 14.9961V17.8964V18.2963V18.3964C-0.00216686 18.3964 0.00173349 18.3964 0.00173349 18.4964C0.00173349 20.8966 4.0315 22.9968 9.00254 22.9968C13.974 22.9968 18.0033 20.8966 18.0033 18.4964V18.2963V17.9964V14.9961H0.00173349Z\\\" fill=\\\"#2B5F7C\\\"/>\\n            <path d=\\\"M18.0036 15.0004C18.0036 17.2097 13.9742 19.0007 9.00276 19.0007C4.03171 19.0007 0.00195312 17.2097 0.00195312 15.0004C0.00195312 12.7911 4.03171 11 9.00276 11C13.9742 11 18.0036 12.7911 18.0036 15.0004Z\\\" fill=\\\"#BDC3C7\\\"/>\\n            <path d=\\\"M0.00173349 9.99609V12.8964V13.2963V13.3964C-0.00216686 13.3964 0.00173349 13.3964 0.00173349 13.4964C0.00173349 15.8966 4.0315 17.9968 9.00254 17.9968C13.974 17.9968 18.0033 15.8966 18.0033 13.4964V13.2963V12.9964V9.99609H0.00173349Z\\\" fill=\\\"#2B5F7C\\\"/>\\n            <path d=\\\"M18.0036 9.99645C18.0036 12.2058 13.9742 13.9968 9.00276 13.9968C4.03171 13.9968 0.00195312 12.2058 0.00195312 9.99645C0.00195312 7.78715 4.03171 5.99609 9.00276 5.99609C13.9742 5.99609 18.0036 7.78715 18.0036 9.99645Z\\\" fill=\\\"#BDC3C7\\\"/>\\n            <path d=\\\"M0.0644587 13.4961C0.0184546 13.5961 0.00195312 13.7961 0.00195312 13.9961C0.00195312 16.1963 4.03171 17.9965 9.00276 17.9965C13.9742 17.9965 18.0036 16.1963 18.0036 13.9961C18.0036 13.7961 17.9866 13.5961 17.9416 13.4961C17.3875 15.3963 13.5922 16.9964 9.00276 16.9964C4.41295 16.9964 0.618308 15.3963 0.0644587 13.4961Z\\\" fill=\\\"#ECF0F1\\\"/>\\n            <path d=\\\"M0.00173349 4.99609V7.89638V8.29632V8.39642C-0.00216686 8.39642 0.00173349 8.3964 0.00173349 8.49641C0.00173349 10.8966 4.0315 12.9968 9.00254 12.9968C13.974 12.9968 18.0033 10.8966 18.0033 8.49641V8.29632V7.99636V4.99609H0.00173349Z\\\" fill=\\\"#2B5F7C\\\"/>\\n  